// HVN Profile + Absorption
// Multi-period volume profile with smoothed High Volume Node detection,
// POC / level extension, HVN touch alerts, and an effort-vs-result absorption
// detector (optionally using lower-timeframe volume delta).
// Python twin of this script: indicators/hvn_absorption.py
//@version=6
indicator("HVN Profile + Absorption", "HVN+ABS", overlay = true, max_boxes_count = 500, max_lines_count = 100, max_labels_count = 100, max_bars_back = 2000)

// ─────────────────────────────── Inputs ───────────────────────────────
grpP = "HVN Profile"
lb1        = input.int(100, "Lookback 1 (bars)", minval = 20, maxval = 2000, group = grpP)
lb2        = input.int(300, "Lookback 2 (bars, 0 = off)", minval = 0, maxval = 2000, group = grpP)
rows       = input.int(60, "Price rows", minval = 20, maxval = 150, group = grpP)
sigma      = input.float(1.5, "Smoothing (rows, Gaussian)", minval = 0, step = 0.5, group = grpP, tooltip = "Clusters neighbouring busy rows into one node. 0 = raw profile.")
thrPct     = input.float(70, "HVN threshold (percentile)", minval = 0, maxval = 99, group = grpP, tooltip = "A peak must be at least this percentile of all rows to count as an HVN.")
zoneRatio  = input.float(80, "Zone width (% of peak volume)", minval = 50, maxval = 99, group = grpP)
minSep     = input.int(3, "Min rows between nodes", minval = 1, group = grpP)
maxNodes   = input.int(6, "Max nodes per profile", minval = 1, maxval = 15, group = grpP)
mergeTol   = input.float(0.5, "Merge tolerance across lookbacks (%)", minval = 0, step = 0.1, group = grpP)
extRight   = input.int(25, "Extend levels right (bars)", minval = 0, maxval = 300, group = grpP)
showHist   = input.bool(true, "Show profile histogram (longest lookback)", group = grpP)
histWidth  = input.int(40, "Histogram width (bars)", minval = 5, maxval = 150, group = grpP)

grpA = "Absorption"
rvolLen    = input.int(20, "Relative volume length", minval = 2, group = grpA)
minRvol    = input.float(1.5, "Min relative volume", minval = 1, step = 0.1, group = grpA)
heavyRvol  = input.float(2.5, "Heavy absorption relative volume", minval = 1, step = 0.1, group = grpA)
atrLen     = input.int(14, "ATR length", minval = 1, group = grpA)
maxBodyAtr = input.float(0.5, "Max net move |close-open| (x ATR)", minval = 0.05, step = 0.05, group = grpA, tooltip = "High effort, little result: lots of volume but the bar made little net progress.")
useDelta   = input.bool(true, "Use lower-timeframe volume delta", group = grpA, tooltip = "Approximates buy/sell aggression from lower-timeframe candles. Falls back to wick/close-location when no intrabar data is available.")
ltf        = input.timeframe("1", "Delta timeframe", group = grpA)
minDelta   = input.float(10, "Min |delta| (% of volume)", minval = 0, step = 1, group = grpA)
colorBars  = input.bool(false, "Color absorption bars", group = grpA)

grpC = "Colors"
cHvn   = input.color(color.new(#2962FF, 80), "HVN zone", group = grpC)
cHvnL  = input.color(color.new(#2962FF, 0), "HVN line", group = grpC)
cPoc   = input.color(color.new(#FF9800, 0), "POC line", group = grpC)
cHist  = input.color(color.new(#787B86, 70), "Histogram", group = grpC)
cHistH = input.color(color.new(#2962FF, 50), "Histogram (HVN rows)", group = grpC)
cBull  = input.color(#00C853, "Bullish absorption", group = grpC)
cBear  = input.color(#FF1744, "Bearish absorption", group = grpC)

// ─────────────────────────────── Absorption ───────────────────────────────
float[] ltfDelta = request.security_lower_tf(syminfo.tickerid, ltf, close > open ? volume : close < open ? -volume : 0.0)
float barDelta = useDelta and array.size(ltfDelta) > 0 ? array.sum(ltfDelta) : na

float avgVol  = ta.sma(volume, rvolLen)[1]
float rvol    = avgVol > 0 ? volume / avgVol : na
float atrV    = ta.atr(atrLen)
float bodyAtr = atrV > 0 ? math.abs(close - open) / atrV : na
float rng     = high - low
float clv     = rng > 0 ? (close - low) / rng : 0.5

bool hasDelta = not na(barDelta) and volume > 0
float dRatio  = hasDelta ? barDelta / volume * 100 : 0.0
bool effort   = rvol >= minRvol
bool smallRes = bodyAtr <= maxBodyAtr
// Bullish: sellers were the aggressors (or price was pushed down into a lower wick) but the bar closed high.
bool bullDir  = hasDelta ? (dRatio <= -minDelta and clv >= 0.5) : clv >= 0.6
bool bearDir  = hasDelta ? (dRatio >= minDelta and clv <= 0.5) : clv <= 0.4
bool bullAbs  = effort and smallRes and bullDir
bool bearAbs  = effort and smallRes and bearDir
bool heavy    = rvol >= heavyRvol

plotshape(bullAbs and not heavy, "Bullish absorption", shape.triangleup, location.belowbar, cBull, size = size.tiny)
plotshape(bearAbs and not heavy, "Bearish absorption", shape.triangledown, location.abovebar, cBear, size = size.tiny)
plotshape(bullAbs and heavy, "Heavy bullish absorption", shape.labelup, location.belowbar, cBull, text = "ABS", textcolor = color.white, size = size.small)
plotshape(bearAbs and heavy, "Heavy bearish absorption", shape.labeldown, location.abovebar, cBear, text = "ABS", textcolor = color.white, size = size.small)
barcolor(colorBars and bullAbs ? cBull : colorBars and bearAbs ? cBear : na)

alertcondition(bullAbs, "Bullish absorption", "{{ticker}}: bullish absorption at {{close}}")
alertcondition(bearAbs, "Bearish absorption", "{{ticker}}: bearish absorption at {{close}}")
alertcondition(bullAbs and heavy, "Heavy bullish absorption", "{{ticker}}: HEAVY bullish absorption at {{close}}")
alertcondition(bearAbs and heavy, "Heavy bearish absorption", "{{ticker}}: HEAVY bearish absorption at {{close}}")

// ─────────────────────────────── Volume profile ───────────────────────────────
// Spreads each bar's volume over the rows its high-low range overlaps, then
// Gaussian-smooths the rows. Returns [bottom price, row height, smoothed rows].
buildProfile(int lb, int nRows, float sig) =>
    int n = math.min(lb, bar_index + 1)
    float pHi = high
    float pLo = low
    for i = 0 to n - 1
        pHi := math.max(pHi, high[i])
        pLo := math.min(pLo, low[i])
    float step = (pHi - pLo) / nRows
    array<float> raw = array.new<float>(nRows, 0.0)
    if step > 0
        for i = 0 to n - 1
            float h = high[i]
            float l = low[i]
            float v = nz(volume[i])
            float r = h - l
            if r <= 0
                int k = math.max(0, math.min(nRows - 1, int((h - pLo) / step)))
                raw.set(k, raw.get(k) + v)
            else
                int k0 = math.max(0, math.min(nRows - 1, int((l - pLo) / step)))
                int k1 = math.max(k0, math.min(nRows - 1, int((h - pLo) / step)))
                for k = k0 to k1
                    float bLo = pLo + k * step
                    float ov = math.min(h, bLo + step) - math.max(l, bLo)
                    if ov > 0
                        raw.set(k, raw.get(k) + v * ov / r)
    array<float> sm = array.new<float>(nRows, 0.0)
    int rad = sig > 0 ? math.max(1, int(math.round(3 * sig))) : 0
    for k = 0 to nRows - 1
        if rad == 0
            sm.set(k, raw.get(k))
        else
            float acc = 0.0
            float wsum = 0.0
            for j = -rad to rad
                float w = math.exp(-0.5 * math.pow(j / sig, 2))
                wsum += w
                int kk = k + j
                if kk >= 0 and kk < nRows
                    acc += w * raw.get(kk)
            sm.set(k, acc / wsum)
    [pLo, step, sm]

// Finds the HVNs of one profile and merges them into the shared node arrays.
addNodes(float pLo, float step, array<float> sm, array<float> nPrice, array<float> nLo, array<float> nHi, array<float> nStr, array<int> nCnt, array<bool> nPoc) =>
    int n = sm.size()
    float cutoff = sm.percentile_linear_interpolation(thrPct)
    float pocV = sm.max()
    array<int> peaks = array.new<int>()
    if pocV > 0
        for k = 0 to n - 1
            float v = sm.get(k)
            float left = k > 0 ? sm.get(k - 1) : -1.0
            float right = k < n - 1 ? sm.get(k + 1) : -1.0
            if v >= left and v > right and v >= cutoff
                peaks.push(k)
    array<int> chosen = array.new<int>()
    while peaks.size() > 0 and chosen.size() < maxNodes
        int best = 0
        for p = 0 to peaks.size() - 1
            if sm.get(peaks.get(p)) > sm.get(peaks.get(best))
                best := p
        int k = peaks.remove(best)
        bool farEnough = true
        for c in chosen
            if math.abs(k - c) < minSep
                farEnough := false
        if farEnough
            chosen.push(k)
    for k in chosen
        float pk = sm.get(k)
        int lo = k
        int hi = k
        while lo > 0 and sm.get(lo - 1) >= pk * zoneRatio / 100 and sm.get(lo - 1) <= sm.get(lo)
            lo -= 1
        while hi < n - 1 and sm.get(hi + 1) >= pk * zoneRatio / 100 and sm.get(hi + 1) <= sm.get(hi)
            hi += 1
        float price = pLo + (k + 0.5) * step
        float zLo = pLo + lo * step
        float zHi = pLo + (hi + 1) * step
        float strength = pk / pocV * 100
        bool isPoc = pk == pocV
        int match = -1
        if nPrice.size() > 0
            for m = 0 to nPrice.size() - 1
                if math.abs(nPrice.get(m) - price) / nPrice.get(m) * 100 <= mergeTol
                    match := m
        if match < 0
            nPrice.push(price)
            nLo.push(zLo)
            nHi.push(zHi)
            nStr.push(strength)
            nCnt.push(1)
            nPoc.push(isPoc)
        else
            nLo.set(match, math.min(nLo.get(match), zLo))
            nHi.set(match, math.max(nHi.get(match), zHi))
            nCnt.set(match, nCnt.get(match) + 1)
            nPoc.set(match, nPoc.get(match) or isPoc)
            if strength > nStr.get(match)
                nPrice.set(match, price)
                nStr.set(match, strength)

// ─────────────────────────────── Drawing + alerts (last bar) ───────────────────────────────
var array<box> boxes = array.new<box>()
var array<line> lines = array.new<line>()
var array<label> labels = array.new<label>()

if barstate.islast
    for b in boxes
        b.delete()
    for ln in lines
        ln.delete()
    for lb in labels
        lb.delete()
    boxes.clear()
    lines.clear()
    labels.clear()

    array<float> nPrice = array.new<float>()
    array<float> nLo = array.new<float>()
    array<float> nHi = array.new<float>()
    array<float> nStr = array.new<float>()
    array<int> nCnt = array.new<int>()
    array<bool> nPoc = array.new<bool>()

    int lbMax = math.max(lb1, lb2)
    [pLo1, step1, sm1] = buildProfile(lb1, rows, sigma)
    addNodes(pLo1, step1, sm1, nPrice, nLo, nHi, nStr, nCnt, nPoc)
    float histLo = pLo1
    float histStep = step1
    array<float> histSm = sm1
    if lb2 > 0
        [pLo2, step2, sm2] = buildProfile(lb2, rows, sigma)
        addNodes(pLo2, step2, sm2, nPrice, nLo, nHi, nStr, nCnt, nPoc)
        if lb2 > lb1
            histLo := pLo2
            histStep := step2
            histSm := sm2

    int left = bar_index - math.min(lbMax, bar_index + 1) + 1
    int right = bar_index + extRight
    string touched = ""
    if nPrice.size() > 0
        for m = 0 to nPrice.size() - 1
            float p = nPrice.get(m)
            bool poc = nPoc.get(m)
            int cnt = nCnt.get(m)
            boxes.push(box.new(left, nHi.get(m), right, nLo.get(m), border_color = na, bgcolor = cHvn))
            lines.push(line.new(left, p, right, p, color = poc ? cPoc : cHvnL, width = poc ? 2 : 1, style = cnt > 1 ? line.style_solid : line.style_dashed))
            string txt = (poc ? "POC " : "HVN ") + str.tostring(p, format.mintick) + "  " + str.tostring(nStr.get(m), "#") + "%" + (cnt > 1 ? "  x" + str.tostring(cnt) : "")
            labels.push(label.new(right, p, txt, style = label.style_label_left, color = color.new(poc ? cPoc : cHvnL, 20), textcolor = color.white, size = size.small))
            if low <= nHi.get(m) and high >= nLo.get(m)
                touched += (touched == "" ? "" : ", ") + str.tostring(p, format.mintick)

    if showHist and histStep > 0
        float hMax = histSm.max()
        int hx = bar_index + extRight + 1
        for k = 0 to histSm.size() - 1
            int w = hMax > 0 ? int(math.round(histSm.get(k) / hMax * histWidth)) : 0
            if w > 0
                float rLo = histLo + k * histStep
                float rHi = rLo + histStep
                bool inNode = false
                if nPrice.size() > 0
                    for m = 0 to nPrice.size() - 1
                        if rLo < nHi.get(m) and rHi > nLo.get(m)
                            inNode := true
                boxes.push(box.new(hx, rHi, hx + w, rLo, border_color = na, bgcolor = inNode ? cHistH : cHist))

    if touched != ""
        alert(syminfo.ticker + ": price touching HVN " + touched, alert.freq_once_per_bar)
        if bullAbs or bearAbs
            alert(syminfo.ticker + ": " + (heavy ? "HEAVY " : "") + (bullAbs ? "bullish" : "bearish") + " absorption AT HVN " + touched, alert.freq_once_per_bar_close)
