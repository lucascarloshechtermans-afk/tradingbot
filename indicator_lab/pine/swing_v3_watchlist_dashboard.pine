        2022 => -0.261951 - 0.037807 * f_z(ibs, 0.883768, 0.085472) + 0.084280 * f_z(rvol, -0.006379, 0.370950) - 0.038555 * f_z(roc21, 0.071470, 0.056502) - 0.020172 * f_z(roc63, 0.121687, 0.121074) - 0.071451 * f_z(roc126, 0.188567, 0.180411) + 0.042871 * f_z(atrPct, 1.531580, 0.684295) + 0.066476 * f_z(rsi14, 69.749360, 6.253927) - 0.015899 * f_z(ext50, 4.170512, 1.835489) + 0.040357 * f_z(rs63, 0.061577, 0.113135) - 0.019812 * f_z(dist52, -0.017559, 0.036534) - 0.031145 * f_z(bbwPct, 0.532558, 0.282634) - 0.002563 * f_z(gapAtr, 0.219311, 0.558080) - 0.160073 * f_z(spyUp, 0.964520, 0.184990) - 0.143450 * f_z(spyRoc63, 0.060111, 0.048853) + 0.002888 * f_z(rangeAtr, 1.039633, 0.486711) + 0.041825 * f_z(brkAtr, 0.483824, 0.469492) - 0.167783 * f_z(er20, 0.390017, 0.178541)
        2023 => -0.298186 - 0.043071 * f_z(ibs, 0.883717, 0.085347) + 0.099218 * f_z(rvol, -0.005456, 0.371395) - 0.031680 * f_z(roc21, 0.072224, 0.056753) - 0.018415 * f_z(roc63, 0.120192, 0.120594) - 0.068859 * f_z(roc126, 0.187724, 0.179941) + 0.033739 * f_z(atrPct, 1.558205, 0.698984) + 0.077384 * f_z(rsi14, 69.668993, 6.243012) - 0.034366 * f_z(ext50, 4.139582, 1.832983) + 0.034282 * f_z(rs63, 0.062437, 0.113359) + 0.016144 * f_z(dist52, -0.018597, 0.037646) - 0.059513 * f_z(bbwPct, 0.540763, 0.283400) - 0.008657 * f_z(gapAtr, 0.218725, 0.551409) - 0.080546 * f_z(spyUp, 0.950260, 0.217408) - 0.120418 * f_z(spyRoc63, 0.057755, 0.050714) + 0.002526 * f_z(rangeAtr, 1.040294, 0.486223) + 0.045709 * f_z(brkAtr, 0.482932, 0.466699) - 0.159695 * f_z(er20, 0.388145, 0.178896)
        2024 => -0.277216 - 0.023762 * f_z(ibs, 0.882955, 0.085176) + 0.112141 * f_z(rvol, 0.001434, 0.367869) - 0.011549 * f_z(roc21, 0.074033, 0.059298) + 0.036586 * f_z(roc63, 0.125522, 0.129119) - 0.092348 * f_z(roc126, 0.195029, 0.201915) + 0.001700 * f_z(atrPct, 1.596173, 0.719518) + 0.051671 * f_z(rsi14, 69.616098, 6.162373) - 0.042785 * f_z(ext50, 4.122560, 1.813045) + 0.099651 * f_z(rs63, 0.067727, 0.122830) - 0.039292 * f_z(dist52, -0.021864, 0.043373) - 0.080700 * f_z(bbwPct, 0.529907, 0.285505) - 0.009207 * f_z(gapAtr, 0.220061, 0.546430) - 0.056255 * f_z(spyUp, 0.950120, 0.217696) - 0.149157 * f_z(spyRoc63, 0.057795, 0.050392) - 0.024320 * f_z(rangeAtr, 1.045949, 0.488414) + 0.043318 * f_z(brkAtr, 0.482008, 0.461802) - 0.146648 * f_z(er20, 0.385858, 0.177274)
        2025 => -0.260770 - 0.019082 * f_z(ibs, 0.882872, 0.084818) + 0.102035 * f_z(rvol, 0.002929, 0.363919) + 0.013368 * f_z(roc21, 0.075727, 0.060771) + 0.021672 * f_z(roc63, 0.126809, 0.128326) - 0.108731 * f_z(roc126, 0.197403, 0.207946) + 0.009804 * f_z(atrPct, 1.600578, 0.719850) + 0.037091 * f_z(rsi14, 69.819260, 6.203170) - 0.014531 * f_z(ext50, 4.179224, 1.833467) + 0.088743 * f_z(rs63, 0.067080, 0.121457) - 0.033772 * f_z(dist52, -0.020920, 0.041862) - 0.062470 * f_z(bbwPct, 0.534965, 0.286625) - 0.012889 * f_z(gapAtr, 0.220759, 0.541902) - 0.038562 * f_z(spyUp, 0.955136, 0.207005) - 0.159447 * f_z(spyRoc63, 0.059729, 0.050157) - 0.007294 * f_z(rangeAtr, 1.051341, 0.488001) + 0.039258 * f_z(brkAtr, 0.488918, 0.464144) - 0.152381 * f_z(er20, 0.391098, 0.179489)
        2026 => -0.245655 - 0.019252 * f_z(ibs, 0.882598, 0.084759) + 0.085670 * f_z(rvol, 0.006785, 0.362272) + 0.015508 * f_z(roc21, 0.076308, 0.060199) + 0.011462 * f_z(roc63, 0.126912, 0.126937) - 0.138167 * f_z(roc126, 0.194445, 0.204811) + 0.070436 * f_z(atrPct, 1.611930, 0.716586) + 0.027211 * f_z(rsi14, 69.835997, 6.166192) - 0.000945 * f_z(ext50, 4.182523, 1.817074) + 0.079303 * f_z(rs63, 0.066475, 0.119643) - 0.027613 * f_z(dist52, -0.021203, 0.041455) - 0.067073 * f_z(bbwPct, 0.534123, 0.288047) - 0.009771 * f_z(gapAtr, 0.222340, 0.541392) - 0.019720 * f_z(spyUp, 0.956245, 0.204550) - 0.158138 * f_z(spyRoc63, 0.060437, 0.050798) - 0.000539 * f_z(rangeAtr, 1.049130, 0.486329) + 0.039462 * f_z(brkAtr, 0.488648, 0.463664) - 0.132061 * f_z(er20, 0.392134, 0.179705)
        => float(na)
    thrYear   = switch fitYear
        2015 => 0.347398
        2016 => 0.337838
        2017 => 0.321030
        2018 => 0.381777
        2019 => 0.378296
        2020 => 0.358101
        2021 => 0.376900
        2022 => 0.382698
        2023 => 0.378597
        2024 => 0.380098
        2025 => 0.387874
        2026 => 0.391499
        => float(na)
    scoreOos  = time > TRAIN_END ? scoreIs : scoreYear
    thrOos    = time > TRAIN_END ? FINAL_THR : thrYear
    score     = scoreOos  // the signals use the out-of-sample score
    quality   = 1 / (1 + math.exp(-scoreOos))
    qualityIs = 1 / (1 + math.exp(-scoreIs))
    // minQual is an absolute threshold for the final fit; on OOS bars the same shift is applied to that year's own threshold
    qualityOk   = not useModel or (not na(quality) and quality * 100 >= thrOos * 100 + (minQual - FINAL_THR * 100))
    qualityOkIs = not useModel or (not na(qualityIs) and qualityIs * 100 >= minQual)
    // <</GEN:MODEL>>
    var int   state = 0
    var float hh    = na
    var float stop  = na
    buySig  = false
    sellSig = false
    exited  = false
    if state == 3
        state := 0
        stop := na
        exited := true
    if state == 1
        state := 2
        hh := high
        initStop = open - trailMult * atr[1]
        stop := math.max(initStop, hh - trailMult * atr)
        if low <= initStop
            sellSig := true
            state := 0
            stop := na
        else if close < loM
            sellSig := true
            state := 3
    else if state == 2
        if low <= stop
            sellSig := true
            state := 0
            stop := na
        else
            hh := math.max(hh, high)
            stop := math.max(stop, hh - trailMult * atr)
            if close < loM
                sellSig := true
                state := 3
    if state == 0 and close > hiN and close > trendMa and ibs >= ibsMin and qualityOk and not sellSig and not exited
        buySig := true
        state := 1
    status = buySig ? 1 : sellSig ? -1 : (state == 2 or state == 3) ? 2 : 0
    [status, quality, stop, close]


// evaluated on every bar (global scope) so each symbol's state machine sees its full history
[st01, q01, sp01, c01] = request.security(s01, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st02, q02, sp02, c02] = request.security(s02, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st03, q03, sp03, c03] = request.security(s03, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st04, q04, sp04, c04] = request.security(s04, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st05, q05, sp05, c05] = request.security(s05, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st06, q06, sp06, c06] = request.security(s06, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st07, q07, sp07, c07] = request.security(s07, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st08, q08, sp08, c08] = request.security(s08, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st09, q09, sp09, c09] = request.security(s09, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st10, q10, sp10, c10] = request.security(s10, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st11, q11, sp11, c11] = request.security(s11, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st12, q12, sp12, c12] = request.security(s12, "D", f_v3(), lookahead = barmerge.lookahead_off)

spyPark = request.security(spySym, "D", close > ta.sma(close, 200))
var table dash = table.new(position.top_right, 4, 14, bgcolor = color.new(color.black, 75), border_width = 1)
f_row(int r, string sym, int st, float q, float sp, float c) =>
    txt = st == 1 ? "BUY" : st == -1 ? "SELL" : st == 2 ? "LONG" : "-"
    col = st == 1 ? color.green : st == -1 ? color.red : st == 2 ? color.new(color.green, 60) : color.new(color.gray, 70)
    parts = str.split(sym, ":")
    table.cell(dash, 0, r, array.get(parts, array.size(parts) - 1), text_color = color.white)
    table.cell(dash, 1, r, txt, text_color = color.white, bgcolor = col)
    table.cell(dash, 2, r, na(q) ? "-" : str.tostring(q * 100, "#") + "%", text_color = color.white)
    table.cell(dash, 3, r, st == 2 and not na(sp) ? "stop " + str.tostring(sp, "#.##") + " (" + str.tostring((c - sp) / c * 100, "#.#") + "%)" : "", text_color = color.white)

if barstate.islast
    table.cell(dash, 0, 0, "Ticker", text_color = color.white)
    table.cell(dash, 1, 0, "Swing v3", text_color = color.white)
    table.cell(dash, 2, 0, "Quality", text_color = color.white)
    table.cell(dash, 3, 0, "Stop (risk)", text_color = color.white)
    f_row(1, s01, st01, q01, sp01, c01)
    f_row(2, s02, st02, q02, sp02, c02)
    f_row(3, s03, st03, q03, sp03, c03)
    f_row(4, s04, st04, q04, sp04, c04)
    f_row(5, s05, st05, q05, sp05, c05)
    f_row(6, s06, st06, q06, sp06, c06)
    f_row(7, s07, st07, q07, sp07, c07)
    f_row(8, s08, st08, q08, sp08, c08)
    f_row(9, s09, st09, q09, sp09, c09)
    f_row(10, s10, st10, q10, sp10, c10)
    f_row(11, s11, st11, q11, sp11, c11)
    f_row(12, s12, st12, q12, sp12, c12)
    table.cell(dash, 0, 13, "Idle cash → SPY", text_color = color.white)
    table.cell(dash, 1, 13, spyPark ? "YES" : "NO", text_color = color.white, bgcolor = spyPark ? color.new(color.green, 40) : color.new(color.orange, 40))
