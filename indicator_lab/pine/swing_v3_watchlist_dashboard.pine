//@version=6
// Swing v3 WATCHLIST DASHBOARD — the v3 rules (identical to swing_v3_quality_model.pine) evaluated
// for up to 12 symbols in one table: BUY today / SELL today / LONG (+ current trailing stop) / flat,
// plus breakout quality. For users without TradingView's Pine Screener. Daily data. Not financial advice.
indicator("Swing v3 watchlist dashboard", overlay = true)

n         = input.int(20, "Breakout lookback (days)", minval = 2)
m         = input.int(20, "Exit lookback (days)", minval = 2)
trailMult = input.float(4.0, "Trail (x ATR14)", minval = 0.5, step = 0.25)
trendLen  = input.int(200, "Trend filter SMA", minval = 10)
ibsMin    = input.float(0.7, "Min close position in day range (0-1)", minval = 0, maxval = 1, step = 0.05)
useModel  = input.bool(true, "Use quality model (v3); off = v2")
minQual   = input.float(39.3009, "Min breakout quality % (default = model threshold; higher = stricter)", minval = 0, maxval = 100, step = 1)
spySym    = input.symbol("AMEX:SPY", "Market reference")
s01 = input.symbol("NASDAQ:NVDA", "Symbol 1", group = "Watchlist")
s02 = input.symbol("NASDAQ:AMD", "Symbol 2", group = "Watchlist")
s03 = input.symbol("NASDAQ:META", "Symbol 3", group = "Watchlist")
s04 = input.symbol("NASDAQ:TSLA", "Symbol 4", group = "Watchlist")
s05 = input.symbol("NASDAQ:AVGO", "Symbol 5", group = "Watchlist")
s06 = input.symbol("NYSE:PLTR", "Symbol 6", group = "Watchlist")
s07 = input.symbol("NASDAQ:CRWD", "Symbol 7", group = "Watchlist")
s08 = input.symbol("NYSE:ANET", "Symbol 8", group = "Watchlist")
s09 = input.symbol("NASDAQ:MU", "Symbol 9", group = "Watchlist")
s10 = input.symbol("NYSE:GE", "Symbol 10", group = "Watchlist")
s11 = input.symbol("NYSE:CAT", "Symbol 11", group = "Watchlist")
s12 = input.symbol("NASDAQ:COIN", "Symbol 12", group = "Watchlist")

// The <<GEN:...>> regions are generated by `python -m indicator_lab.export_pine` — do not edit them by hand.
// <<GEN:HELPERS>>
// Python (meta.feature_frame, pandas) is the reference for every model feature; pine_parity.py checks it.
// ta.rma seeds with an SMA, pandas ewm(adjust=False) with the first value: this reproduces pandas.
f_rma_py(float src, simple int len) =>
    var float s = na
    var int cnt = 0
    if not na(src)
        s := na(s) ? src : (src + (len - 1) * s) / len
        cnt += 1
    cnt >= len ? s : na

// pandas rolling(len, min_periods = minCnt).rank(pct = True): current bar included, ties averaged
// (ta.percentrank counts only the PREVIOUS len values).
f_rank_incl(float x, simple int len, simple int minCnt) =>
    float res = na
    if not na(x)
        int cnt = 0
        int less = 0
        int eq = 0
        for i = 0 to len - 1
            v = x[i]
            if not na(v)
                cnt += 1
                less += v < x ? 1 : 0
                eq += v == x ? 1 : 0
        res := cnt >= minCnt ? (less + (eq + 1) / 2.0) / cnt : na
    res

f_z(x, mu, sd) => nz((x - mu) / sd)
// <</GEN:HELPERS>>

// full v3 state machine for the requested symbol; returns [status, quality, stop, close]
// status: 1 BUY today, -1 SELL today, 2 long, 0 flat
f_v3() =>
    // <<GEN:FEATURES>>
    trueRange = na(close[1]) ? high - low : math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
    atr       = f_rma_py(trueRange, 14)
    chg       = ta.change(close)
    rsiUp     = f_rma_py(na(chg) ? na : math.max(chg, 0), 14)
    rsiDn     = f_rma_py(na(chg) ? na : math.max(-chg, 0), 14)
    spyToday  = request.security(spySym, "D", close)
    spyPrev   = request.security(spySym, "D", close[1])
    spy       = syminfo.timezone == "America/New_York" ? spyToday : spyPrev
    volRatio  = volume / ta.sma(volume, 50)
    ibs       = high > low ? (close - low) / (high - low) : 0.5
    rvol      = na(volRatio) ? na : math.log(math.max(volRatio, 0.05))
    roc21     = close / close[21] - 1
    roc63     = close / close[63] - 1
    roc126    = close / close[126] - 1
    atrPct    = atr / close * 100
    rsi14     = na(rsiUp) or na(rsiDn) ? na : rsiDn == 0 ? 100.0 : 100 - 100 / (1 + rsiUp / rsiDn)
    ext50     = (close - ta.sma(close, 50)) / atr
    spyRoc63  = spy / spy[63] - 1
    rs63      = roc63 - spyRoc63
    hi52      = bar_index >= 199 ? ta.highest(high, math.min(bar_index + 1, 252)) : na
    dist52    = close / hi52 - 1
    bbw       = 4 * ta.stdev(close, 20) / ta.sma(close, 20)
    bbwPct    = f_rank_incl(bbw, 252, 100)
    gapAtr    = (open - close[1]) / atr[1]
    spyUp     = spy > ta.sma(spy, 200) ? 1.0 : 0.0
    rangeAtr  = (high - low) / atr[1]
    brkAtr    = (close - ta.highest(high, 20)[1]) / atr
    er20      = math.abs(close - close[20]) / math.sum(math.abs(ta.change(close)), 20)
    // <</GEN:FEATURES>>
    trendMa = ta.sma(close, trendLen)
    hiN     = ta.highest(high, n)[1]
    loM     = ta.lowest(low, m)[1]
    // <<GEN:MODEL>>
    // FINAL fit: 3633 closed DEV breakouts up to 2026-10-20; threshold 0.393009 = v3_model.json "thr" (25th pct of its training predictions).
    FINAL_THR = 0.393009
    scoreIs = -0.243512 - 0.012028 * f_z(ibs, 0.882207, 0.084672) + 0.077133 * f_z(rvol, 0.003919, 0.361995) + 0.015587 * f_z(roc21, 0.077099, 0.060410) + 0.016426 * f_z(roc63, 0.126093, 0.125672) - 0.139563 * f_z(roc126, 0.194343, 0.202689) + 0.049966 * f_z(atrPct, 1.623357, 0.713240) + 0.026913 * f_z(rsi14, 69.836667, 6.165982) - 0.021419 * f_z(ext50, 4.176703, 1.826246) + 0.089082 * f_z(rs63, 0.066030, 0.118733) - 0.014834 * f_z(dist52, -0.021020, 0.041071) - 0.046283 * f_z(bbwPct, 0.542481, 0.289020) - 0.015639 * f_z(gapAtr, 0.222430, 0.543220) - 0.010637 * f_z(spyUp, 0.958161, 0.200220) - 0.169306 * f_z(spyRoc63, 0.060063, 0.050280) - 0.010604 * f_z(rangeAtr, 1.051659, 0.484647) + 0.053239 * f_z(brkAtr, 0.487312, 0.462300) - 0.134906 * f_z(er20, 0.391484, 0.180468)
    // OOS: on history each bar uses the walk-forward fit of its own year, trained only on breakouts whose
    // trade closed before 1 Jan of that year (v3_model_yearly.json). Bars after TRAIN_END (the last bar
    // the final fit has seen) use the final fit. Before the first fit year there is no model (no BUY).
    TRAIN_END = timestamp("UTC", 2026, 10, 20, 23, 59)
    fitYear   = year(time)
    scoreYear = switch fitYear
        2015 => -0.405449 + 0.074646 * f_z(ibs, 0.887154, 0.085169) + 0.062733 * f_z(rvol, -0.004906, 0.390531) + 0.020430 * f_z(roc21, 0.062693, 0.053731) - 0.061505 * f_z(roc63, 0.109502, 0.127008) - 0.080234 * f_z(roc126, 0.179468, 0.164466) + 0.029252 * f_z(atrPct, 1.416531, 0.586139) - 0.056083 * f_z(rsi14, 69.124762, 5.738042) + 0.079374 * f_z(ext50, 3.982247, 1.774177) - 0.011267 * f_z(rs63, 0.049675, 0.125051) - 0.033240 * f_z(dist52, -0.014326, 0.035715) + 0.069605 * f_z(bbwPct, 0.537074, 0.297719) + 0.070044 * f_z(gapAtr, 0.196658, 0.684831) - 0.214465 * f_z(spyRoc63, 0.059827, 0.029854) - 0.088632 * f_z(rangeAtr, 1.047951, 0.498495) - 0.008407 * f_z(brkAtr, 0.470025, 0.487755) - 0.144123 * f_z(er20, 0.370543, 0.176825)
        2016 => -0.482367 + 0.073357 * f_z(ibs, 0.885659, 0.084395) + 0.098104 * f_z(rvol, -0.006998, 0.406001) - 0.059538 * f_z(roc21, 0.064955, 0.054287) - 0.038649 * f_z(roc63, 0.103179, 0.118849) + 0.023143 * f_z(roc126, 0.171972, 0.158737) + 0.059010 * f_z(atrPct, 1.462155, 0.572317) - 0.024952 * f_z(rsi14, 68.720570, 5.734171) + 0.060978 * f_z(ext50, 3.862675, 1.732570) - 0.004643 * f_z(rs63, 0.051506, 0.115861) - 0.016073 * f_z(dist52, -0.014764, 0.033640) + 0.005795 * f_z(bbwPct, 0.553876, 0.296486) + 0.054657 * f_z(gapAtr, 0.210787, 0.710169) - 0.034051 * f_z(spyUp, 0.980676, 0.137660) - 0.122137 * f_z(spyRoc63, 0.051674, 0.033204) - 0.056270 * f_z(rangeAtr, 1.036967, 0.498469) - 0.027559 * f_z(brkAtr, 0.475348, 0.529235) - 0.194306 * f_z(er20, 0.366753, 0.175372)
        2017 => -0.486819 + 0.071610 * f_z(ibs, 0.884660, 0.084697) + 0.060650 * f_z(rvol, -0.007812, 0.407168) - 0.020361 * f_z(roc21, 0.067864, 0.056071) - 0.030595 * f_z(roc63, 0.111986, 0.130736) + 0.053185 * f_z(roc126, 0.187741, 0.196642) + 0.085447 * f_z(atrPct, 1.526502, 0.613090) - 0.023427 * f_z(rsi14, 68.652686, 5.736646) + 0.000019 * f_z(ext50, 3.884902, 1.721381) + 0.017800 * f_z(rs63, 0.064338, 0.127909) + 0.012182 * f_z(dist52, -0.016696, 0.033767) + 0.030839 * f_z(bbwPct, 0.542746, 0.292935) + 0.043619 * f_z(gapAtr, 0.208872, 0.694792) - 0.152249 * f_z(spyUp, 0.955224, 0.206812) - 0.163720 * f_z(spyRoc63, 0.047649, 0.038338) + 0.002085 * f_z(rangeAtr, 1.040883, 0.495454) - 0.001763 * f_z(brkAtr, 0.468678, 0.520201) - 0.188100 * f_z(er20, 0.364593, 0.172656)
        2018 => -0.277588 + 0.002632 * f_z(ibs, 0.881862, 0.085889) + 0.106005 * f_z(rvol, 0.006147, 0.397020) - 0.026623 * f_z(roc21, 0.067084, 0.057332) - 0.080071 * f_z(roc63, 0.110051, 0.124794) + 0.039330 * f_z(roc126, 0.185726, 0.189211) + 0.028755 * f_z(atrPct, 1.443145, 0.609316) + 0.127525 * f_z(rsi14, 69.631497, 6.287828) - 0.024044 * f_z(ext50, 4.076358, 1.802579) - 0.038221 * f_z(rs63, 0.061759, 0.122450) + 0.022643 * f_z(dist52, -0.014543, 0.030741) - 0.058892 * f_z(bbwPct, 0.546738, 0.288988) + 0.046229 * f_z(gapAtr, 0.218821, 0.665594) - 0.139207 * f_z(spyUp, 0.965909, 0.181463) - 0.150328 * f_z(spyRoc63, 0.048293, 0.035338) - 0.010817 * f_z(rangeAtr, 1.056099, 0.505954) + 0.009785 * f_z(brkAtr, 0.483450, 0.513363) - 0.164771 * f_z(er20, 0.382903, 0.181747)
        2019 => -0.264145 - 0.009400 * f_z(ibs, 0.882345, 0.086788) + 0.139965 * f_z(rvol, 0.011641, 0.383981) - 0.058496 * f_z(roc21, 0.065972, 0.054758) - 0.065437 * f_z(roc63, 0.109997, 0.117723) + 0.060442 * f_z(roc126, 0.181155, 0.178620) - 0.108323 * f_z(atrPct, 1.422123, 0.608401) + 0.097168 * f_z(rsi14, 69.920595, 6.426102) + 0.017838 * f_z(ext50, 4.168669, 1.868736) - 0.008382 * f_z(rs63, 0.059914, 0.114790) - 0.028368 * f_z(dist52, -0.014036, 0.029233) - 0.060647 * f_z(bbwPct, 0.559305, 0.284839) + 0.055538 * f_z(gapAtr, 0.218631, 0.622717) - 0.127284 * f_z(spyUp, 0.969626, 0.171614) - 0.188697 * f_z(spyRoc63, 0.050083, 0.035725) - 0.015527 * f_z(rangeAtr, 1.057045, 0.497536) + 0.023085 * f_z(brkAtr, 0.490648, 0.497026) - 0.190202 * f_z(er20, 0.389193, 0.183338)
