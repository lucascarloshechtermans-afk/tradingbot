//@version=6
// Swing v3 WATCHLIST DASHBOARD — the v3 rules (identical to swing_v3_quality_model.pine) evaluated
// for up to 12 symbols in one table: BUY today / SELL today / LONG (+ current trailing stop) / flat,
// plus breakout quality. For users without TradingView's Pine Screener. Daily data. Not financial advice.
indicator("Swing v3 watchlist dashboard", overlay = true)

n         = input.int(20, "Breakout lookback (days)", minval = 2)
m         = input.int(20, "Exit lookback (days)", minval = 2)
trailMult = input.float(4.0, "Trail (x ATR14)", minval = 0.5, step = 0.25)
trendLen  = input.int(200, "Trend filter SMA", minval = 10)
ibsMin    = input.float(0.7, "Min close position in day range (0-1)", minval = 0, maxval = 1, step = 0.05)
useModel  = input.bool(true, "Use quality model (v3); off = v2")
spySym    = input.symbol("AMEX:SPY", "Market reference")
s01 = input.symbol("NASDAQ:NVDA", "Symbol 1", group = "Watchlist")
s02 = input.symbol("NASDAQ:AMD", "Symbol 2", group = "Watchlist")
s03 = input.symbol("NASDAQ:META", "Symbol 3", group = "Watchlist")
s04 = input.symbol("NASDAQ:TSLA", "Symbol 4", group = "Watchlist")
s05 = input.symbol("NASDAQ:AVGO", "Symbol 5", group = "Watchlist")
s06 = input.symbol("NYSE:PLTR", "Symbol 6", group = "Watchlist")
s07 = input.symbol("NASDAQ:CRWD", "Symbol 7", group = "Watchlist")
s08 = input.symbol("NYSE:ANET", "Symbol 8", group = "Watchlist")
s09 = input.symbol("NASDAQ:MU", "Symbol 9", group = "Watchlist")
s10 = input.symbol("NYSE:GE", "Symbol 10", group = "Watchlist")
s11 = input.symbol("NYSE:CAT", "Symbol 11", group = "Watchlist")
s12 = input.symbol("NASDAQ:COIN", "Symbol 12", group = "Watchlist")

f_z(x, mu, sd) => nz((x - mu) / sd)

// full v3 state machine for the requested symbol; returns [status, quality, stop, close]
// status: 1 BUY today, -1 SELL today, 2 long, 0 flat
f_v3() =>
    spy     = request.security(spySym, "D", close)
    atr     = ta.atr(14)
    trendMa = ta.sma(close, trendLen)
    hiN     = ta.highest(high, n)[1]
    loM     = ta.lowest(low, m)[1]
    ibs     = high > low ? (close - low) / (high - low) : 0.5
    volRatio = volume / ta.sma(volume, 50)
    rvol     = math.log(math.max(volRatio, 0.05))
    roc21    = close / close[21] - 1
    roc63    = close / close[63] - 1
    roc126   = close / close[126] - 1
    atrPct   = atr / close * 100
    rsi14    = ta.rsi(close, 14)
    ext50    = (close - ta.sma(close, 50)) / atr
    spyRoc63 = spy / spy[63] - 1
    rs63     = roc63 - spyRoc63
    dist52   = close / ta.highest(high, 252) - 1
    bbw      = 4 * ta.stdev(close, 20) / ta.sma(close, 20)
    bbwPct   = ta.percentrank(bbw, 252) / 100
    gapAtr   = (open - close[1]) / atr[1]
    spyUp    = spy > ta.sma(spy, 200) ? 1.0 : 0.0
    rangeAtr = (high - low) / atr[1]
    brkAtr   = (close - ta.highest(high, 20)[1]) / atr
    er20     = math.abs(close - close[20]) / math.sum(math.abs(ta.change(close)), 20)
    score = -0.239166
         + -0.013667 * f_z(ibs, 0.882077, 0.084629)
         + +0.076333 * f_z(rvol, 0.004562, 0.362269)
         + +0.016040 * f_z(roc21, 0.077442, 0.060907)
         + +0.012175 * f_z(roc63, 0.126248, 0.125601)
         + -0.138152 * f_z(roc126, 0.194296, 0.202241)
         + +0.057250 * f_z(atrPct, 1.628976, 0.716738)
         + +0.032266 * f_z(rsi14, 69.835640, 6.166100)
         + -0.019922 * f_z(ext50, 4.170886, 1.825834)
         + +0.083876 * f_z(rs63, 0.066311, 0.118742)
         + -0.026856 * f_z(dist52, -0.021334, 0.041406)
         + -0.045780 * f_z(bbwPct, 0.542970, 0.289047)
         + -0.012404 * f_z(gapAtr, 0.224549, 0.546279)
         + -0.007950 * f_z(spyUp, 0.958425, 0.199617)
         + -0.168088 * f_z(spyRoc63, 0.059937, 0.050155)
         + -0.014471 * f_z(rangeAtr, 1.052503, 0.485749)
         + +0.053219 * f_z(brkAtr, 0.488135, 0.464076)
         + -0.137207 * f_z(er20, 0.391360, 0.180358)
    qualityOk = not useModel or score >= -0.436348
    var int   state = 0
    var float hh    = na
    var float stop  = na
    buySig  = false
    sellSig = false
    exited  = false
    if state == 3
        state := 0
        stop := na
        exited := true
    if state == 1
        state := 2
        hh := high
        stop := hh - trailMult * atr
        if close < loM
            sellSig := true
            state := 3
    else if state == 2
        if low <= stop
            sellSig := true
            state := 0
            stop := na
        else
            hh := math.max(hh, high)
            stop := math.max(stop, hh - trailMult * atr)
            if close < loM
                sellSig := true
                state := 3
    if state == 0 and close > hiN and close > trendMa and ibs >= ibsMin and qualityOk and not sellSig and not exited
        buySig := true
        state := 1
    status = buySig ? 1 : sellSig ? -1 : (state == 2 or state == 3) ? 2 : 0
    [status, 1 / (1 + math.exp(-score)), stop, close]


// evaluated on every bar (global scope) so each symbol's state machine sees its full history
[st01, q01, sp01, c01] = request.security(s01, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st02, q02, sp02, c02] = request.security(s02, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st03, q03, sp03, c03] = request.security(s03, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st04, q04, sp04, c04] = request.security(s04, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st05, q05, sp05, c05] = request.security(s05, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st06, q06, sp06, c06] = request.security(s06, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st07, q07, sp07, c07] = request.security(s07, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st08, q08, sp08, c08] = request.security(s08, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st09, q09, sp09, c09] = request.security(s09, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st10, q10, sp10, c10] = request.security(s10, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st11, q11, sp11, c11] = request.security(s11, "D", f_v3(), lookahead = barmerge.lookahead_off)
[st12, q12, sp12, c12] = request.security(s12, "D", f_v3(), lookahead = barmerge.lookahead_off)

var table dash = table.new(position.top_right, 4, 13, bgcolor = color.new(color.black, 75), border_width = 1)
f_row(int r, string sym, int st, float q, float sp, float c) =>
    txt = st == 1 ? "BUY" : st == -1 ? "SELL" : st == 2 ? "LONG" : "-"
    col = st == 1 ? color.green : st == -1 ? color.red : st == 2 ? color.new(color.green, 60) : color.new(color.gray, 70)
    parts = str.split(sym, ":")
    table.cell(dash, 0, r, array.get(parts, array.size(parts) - 1), text_color = color.white)
    table.cell(dash, 1, r, txt, text_color = color.white, bgcolor = col)
    table.cell(dash, 2, r, na(q) ? "-" : str.tostring(q * 100, "#") + "%", text_color = color.white)
    table.cell(dash, 3, r, st == 2 and not na(sp) ? "stop " + str.tostring(sp, "#.##") + " (" + str.tostring((c - sp) / c * 100, "#.#") + "%)" : "", text_color = color.white)

if barstate.islast
    table.cell(dash, 0, 0, "Ticker", text_color = color.white)
    table.cell(dash, 1, 0, "Swing v3", text_color = color.white)
    table.cell(dash, 2, 0, "Quality", text_color = color.white)
    table.cell(dash, 3, 0, "Stop (risk)", text_color = color.white)
    f_row(1, s01, st01, q01, sp01, c01)
    f_row(2, s02, st02, q02, sp02, c02)
    f_row(3, s03, st03, q03, sp03, c03)
    f_row(4, s04, st04, q04, sp04, c04)
    f_row(5, s05, st05, q05, sp05, c05)
    f_row(6, s06, st06, q06, sp06, c06)
    f_row(7, s07, st07, q07, sp07, c07)
    f_row(8, s08, st08, q08, sp08, c08)
    f_row(9, s09, st09, q09, sp09, c09)
    f_row(10, s10, st10, q10, sp10, c10)
    f_row(11, s11, st11, q11, sp11, c11)
    f_row(12, s12, st12, q12, sp12, c12)
