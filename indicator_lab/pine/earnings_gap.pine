//@version=6
// Post-earnings gap (setup 11 of the research, indicator_lab/week/pead_week.py + pead_improve.py). DAILY chart, long only.
// RESEARCH VERDICT: NOT APPROVED. Best variant on the test years 2023-2026: PF 1.03, +0.12% per trade, 30% win rate,
// 656 trades (train 2015-2022 was PF 1.28). Better than random entries (PF 0.85), but not significant and unstable
// per year. Use it as a watchlist / paper-trading tool, not as a proven system.
//
// Signal (on the earnings reaction day, judged at its close): earnings report on this bar or the previous bar,
// open >= gap% above the previous close, volume >= x times the 50-day average before today, close > open,
// SPY > its SMA200, close > $5, 50-day dollar volume > $20M, ADR(20) > ADR%. Optional (defaults = the final tested
// variant): close > SMA200, volume >= 3x, EPS surprise > 0.
// Entry: next open. Initial stop: signal-day low - 0.1 ATR (if the next open is already below it: open - 1 ATR).
// Exits (same bar: stop first; gaps fill at the open):
//   A-EMA20  after +1R stop to break-even; close below the 20 EMA -> sell at the next open
//   A-3ATR   after +1R stop to break-even; chandelier: highest high since entry - 3 ATR
//   B        50% at +10% (stop to break-even), the rest at +20%
//   all: time exit at the close of day N. Costs in the table: 0.05% + $0.02 per side.
// Earnings dates come from TradingView (request.earnings); a report after the close shows on the report day,
// so the reaction day is the next bar: both are accepted.
indicator("Earnings gap (setup 11)", overlay = true, max_labels_count = 500, max_lines_count = 500)

gapPct   = input.float(5.0, "Min gap %", minval = 0.0, step = 0.5)
volMult  = input.float(3.0, "Min volume x 50-day avg (research: 2, final variant 3)", minval = 0.0, step = 0.5)
adrMin   = input.float(3.0, "Min ADR(20) %", minval = 0.0, step = 0.5)
minPrice = input.float(5.0, "Min price $")
minDV    = input.float(20.0, "Min 50-day dollar volume ($M)")
useS200  = input.bool(true, "Close above SMA200 (final variant)")
useEps   = input.bool(false, "EPS surprise > 0 (did not help in the research)")
useReg   = input.bool(true, "Market regime: SPY above SMA200")
regSym   = input.symbol("AMEX:SPY", "Regime symbol")
exitMode = input.string("A-EMA20", "Exit", options = ["A-EMA20", "A-3ATR", "B"])
hold     = input.int(40, "Max days in trade", minval = 1)
fromY    = input.int(2015, "Stats from year", minval = 1990)
showTbl  = input.bool(true, "Show stats table")

// ---- signal ----
atr   = ta.atr(14)
e20   = ta.ema(close, 20)
s200  = ta.sma(close, 200)
adr   = ta.sma(high / low - 1, 20) * 100
dv    = ta.sma(close * volume, 50)
va50  = ta.sma(volume, 50)[1]
epsA  = request.earnings(syminfo.tickerid, earnings.actual, barmerge.gaps_on, barmerge.lookahead_on)
epsE  = request.earnings(syminfo.tickerid, earnings.estimate, barmerge.gaps_on, barmerge.lookahead_on)
isE   = not na(epsA)
react = isE or isE[1]
surp  = isE ? epsA - epsE : isE[1] ? epsA[1] - epsE[1] : na
regUp = request.security(regSym, "D", close > ta.sma(close, 200), lookahead = barmerge.lookahead_off)

gapOk  = open >= (1 + gapPct / 100) * close[1]
volOk  = volume >= volMult * va50
univ   = close > minPrice and dv > minDV * 1e6 and adr > adrMin
signal = react and gapOk and volOk and close > open and univ and (not useReg or regUp) and
     (not useS200 or close > s200) and (not useEps or (not na(surp) and surp > 0))

// ---- position (same rules as pead_week.exit_sim) ----
var bool  inPos = false
var float fill = na
var float stop = na
var float r1 = na
var float hh = na
var float got = 0.0
var float left = 1.0
var bool  half = false
var bool  pend = false
var int   k = 0
var float exitPx = na
var int   nT = 0
var int   nW = 0
var float sumW = 0.0
var float sumL = 0.0
var float sumR = 0.0

buyCost(p) => (p + 0.02) * 1.0005
sellNet(p) => (p - 0.02) * 0.9995

done = false
if not inPos and signal[1] and not na(atr[1]) and open > 0
    inPos := true
    fill := open
    stop := low[1] - 0.1 * atr[1]
    if stop >= fill
        stop := fill - atr[1]
    r1 := fill - stop
    hh := fill
    got := 0.0
    left := 1.0
    half := false
    pend := false
    k := 0
    label.new(bar_index, low, "BUY", style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)
else if inPos
    k += 1

if inPos
    op = k == 0 ? fill : open
    if pend
        got += left * sellNet(op)
        exitPx := op
        done := true
    else if low <= stop
        px = k == 0 ? stop : math.min(op, stop)
        got += left * sellNet(px)
        exitPx := px
        done := true
    else
        newstop = stop
        hh := math.max(hh, high)
        if exitMode == "B"
            if not half and high >= fill * 1.10
                px = k == 0 ? fill * 1.10 : math.max(op, fill * 1.10)
                got += 0.5 * sellNet(px)
                left := 0.5
                half := true
                newstop := math.max(newstop, fill)
            if half and high >= fill * 1.20
                px = k == 0 ? fill * 1.20 : math.max(op, fill * 1.20)
                got += left * sellNet(px)
                exitPx := px
                done := true
        else
            if high >= fill + r1
                newstop := math.max(newstop, fill)
            if exitMode == "A-3ATR"
                newstop := math.max(newstop, hh - 3.0 * atr)
            else if close < e20
                pend := true
        if not done and k == hold - 1
            got += left * sellNet(close)
            exitPx := close
            done := true
        stop := newstop

if done
    ret = got / buyCost(fill) - 1
    if year >= fromY
        nT += 1
        sumR += ret
        if ret > 0
            nW += 1
            sumW += ret
        else
            sumL -= ret
    label.new(bar_index, high, (ret >= 0 ? "+" : "") + str.tostring(ret * 100, "#.0") + "%", style = label.style_label_down,
         color = ret > 0 ? color.teal : color.maroon, textcolor = color.white, size = size.small)
    inPos := false

// ---- display ----
plotshape(signal, "Signal", shape.triangleup, location.belowbar, color.lime, size = size.small)
plot(inPos and not done ? stop : na, "Stop", color.red, 2, plot.style_linebr)
plot(inPos and not done ? fill : na, "Entry", color.gray, 1, plot.style_linebr)
plot(exitMode == "A-EMA20" ? e20 : na, "EMA20", color.new(color.orange, 40))
bgcolor(useReg and not regUp ? color.new(color.red, 92) : na, title = "Regime off")

// Pine Screener / data window columns
plot(signal ? 1 : 0, "Signaal", display = display.data_window)
plot(react ? (open / close[1] - 1) * 100 : na, "Gap %", display = display.data_window)
plot(volume / va50, "Volume x", display = display.data_window)
plot(surp, "EPS surprise", display = display.data_window)
plot(inPos and not done ? 1 : 0, "In positie", display = display.data_window)

alertcondition(signal, "Earnings gap signal", "{{ticker}}: earnings gap signal, buy at the next open")
alertcondition(done, "Earnings gap exit", "{{ticker}}: exit of the earnings-gap trade")

var table tb = table.new(position.bottom_right, 2, 6, bgcolor = color.new(color.black, 20), border_width = 1)
if showTbl and barstate.islast
    pf = sumL > 0 ? sumW / sumL : na
    table.cell(tb, 0, 0, "Earnings gap " + exitMode + " " + str.tostring(hold) + "d", text_color = color.white)
    table.cell(tb, 1, 0, "vanaf " + str.tostring(fromY), text_color = color.white)
    table.cell(tb, 0, 1, "Trades", text_color = color.white)
    table.cell(tb, 1, 1, str.tostring(nT), text_color = color.white)
    table.cell(tb, 0, 2, "Winrate", text_color = color.white)
    table.cell(tb, 1, 2, nT > 0 ? str.tostring(100.0 * nW / nT, "#") + "%" : "-", text_color = color.white)
    table.cell(tb, 0, 3, "Profit factor", text_color = color.white)
    table.cell(tb, 1, 3, na(pf) ? "-" : str.tostring(pf, "#.00"), text_color = color.white)
    table.cell(tb, 0, 4, "Gem. per trade (netto)", text_color = color.white)
    table.cell(tb, 1, 4, nT > 0 ? str.tostring(100 * sumR / nT, "#.00") + "%" : "-", text_color = color.white)
    table.cell(tb, 0, 5, "Onderzoek: test-PF 1,03", text_color = color.yellow)
    table.cell(tb, 1, 5, "NIET goedgekeurd", text_color = color.yellow)
