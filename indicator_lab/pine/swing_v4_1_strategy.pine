    => float(na)
thrYear   = switch fitYear
    2015 => 0.347398
    2016 => 0.337838
    2017 => 0.321030
    2018 => 0.381777
    2019 => 0.378296
    2020 => 0.358101
    2021 => 0.376900
    2022 => 0.382698
    2023 => 0.378597
    2024 => 0.380098
    2025 => 0.387874
    2026 => 0.391499
    => float(na)
scoreOos  = time > TRAIN_END ? scoreIs : scoreYear
thrOos    = time > TRAIN_END ? FINAL_THR : thrYear
score     = scoreOos  // the signals use the out-of-sample score
quality   = 1 / (1 + math.exp(-scoreOos))
qualityIs = 1 / (1 + math.exp(-scoreIs))
// minQual is an absolute threshold for the final fit; on OOS bars the same shift is applied to that year's own threshold
qualityOk   = not useModel or (not na(quality) and quality * 100 >= thrOos * 100 + (minQual - FINAL_THR * 100))
qualityOkIs = not useModel or (not na(qualityIs) and qualityIs * 100 >= minQual)
// <</GEN:MODEL>>

// <<GEN:REGIME>>
// v4 regime rule = swing4/final_spec.json (frozen 2026-10-22, before the single holdout run); accepted at 0.00 / 0.03 / 0.06, the middle was chosen
REGIME_MAX = 0.0300
// <</GEN:REGIME>>
regimeOk   = not useRegime or (not na(spyRoc63) and spyRoc63 <= REGIME_MAX)

inPos      = strategy.position_size > 0
justClosed = strategy.closedtrades > strategy.closedtrades[1]  // engine never re-enters on an exit bar
var float hh        = na
var float trailStop = na
var float sigAtr    = na
if inPos
    hh := na(hh) ? high : math.max(hh, high)
    // initial stop = fill - trailMult x ATR(signal bar), then the chandelier trail (never loosens)
    trailStop := math.max(nz(trailStop, strategy.position_avg_price - trailMult * sigAtr), hh - trailMult * atr)
    strategy.exit("Trail", "Long", stop = trailStop, comment = "trail stop")
    if close < loM
        strategy.close("Long", comment = "close < m-day low")
else
    hh := na
    trailStop := na
    if not justClosed and time >= fromTime and close > hiN and close > trendMa and ibs >= ibsMin and qualityOk and regimeOk
        sigAtr := atr
        strategy.entry("Long", strategy.long, comment = "BUY")
        // protective stop active from the fill bar: trailMult x ATR below the (unknown yet) fill price
        strategy.exit("Trail", "Long", loss = trailMult * atr / syminfo.mintick, comment = "initial stop")

// with the model on, rules other than the training rules select trades the model never saw: warn (step R3)
paramsOff = useModel and (n != TRAIN_N or m != TRAIN_M or trailMult != TRAIN_TRAIL or ibsMin != TRAIN_IBS or trendLen != TRAIN_TREND)
var table warn = table.new(position.top_right, 1, 1)
if barstate.islast and paramsOff
    table.cell(warn, 0, 0, "⚠ " + TRAIN_TXT + ": quality filter not valid for these settings", text_color = color.black, bgcolor = color.yellow)

plot(trendMa, "Trend SMA", color = color.new(color.gray, 40))
plot(inPos ? trailStop : na, "Trailing stop", color = color.red, style = plot.style_linebr)
