    2024 => -0.277216 - 0.023762 * f_z(ibs, 0.882955, 0.085176) + 0.112141 * f_z(rvol, 0.001434, 0.367869) - 0.011549 * f_z(roc21, 0.074033, 0.059298) + 0.036586 * f_z(roc63, 0.125522, 0.129119) - 0.092348 * f_z(roc126, 0.195029, 0.201915) + 0.001700 * f_z(atrPct, 1.596173, 0.719518) + 0.051671 * f_z(rsi14, 69.616098, 6.162373) - 0.042785 * f_z(ext50, 4.122560, 1.813045) + 0.099651 * f_z(rs63, 0.067727, 0.122830) - 0.039292 * f_z(dist52, -0.021864, 0.043373) - 0.080700 * f_z(bbwPct, 0.529907, 0.285505) - 0.009207 * f_z(gapAtr, 0.220061, 0.546430) - 0.056255 * f_z(spyUp, 0.950120, 0.217696) - 0.149157 * f_z(spyRoc63, 0.057795, 0.050392) - 0.024320 * f_z(rangeAtr, 1.045949, 0.488414) + 0.043318 * f_z(brkAtr, 0.482008, 0.461802) - 0.146648 * f_z(er20, 0.385858, 0.177274)
    2025 => -0.260770 - 0.019082 * f_z(ibs, 0.882872, 0.084818) + 0.102035 * f_z(rvol, 0.002929, 0.363919) + 0.013368 * f_z(roc21, 0.075727, 0.060771) + 0.021672 * f_z(roc63, 0.126809, 0.128326) - 0.108731 * f_z(roc126, 0.197403, 0.207946) + 0.009804 * f_z(atrPct, 1.600578, 0.719850) + 0.037091 * f_z(rsi14, 69.819260, 6.203170) - 0.014531 * f_z(ext50, 4.179224, 1.833467) + 0.088743 * f_z(rs63, 0.067080, 0.121457) - 0.033772 * f_z(dist52, -0.020920, 0.041862) - 0.062470 * f_z(bbwPct, 0.534965, 0.286625) - 0.012889 * f_z(gapAtr, 0.220759, 0.541902) - 0.038562 * f_z(spyUp, 0.955136, 0.207005) - 0.159447 * f_z(spyRoc63, 0.059729, 0.050157) - 0.007294 * f_z(rangeAtr, 1.051341, 0.488001) + 0.039258 * f_z(brkAtr, 0.488918, 0.464144) - 0.152381 * f_z(er20, 0.391098, 0.179489)
    2026 => -0.245655 - 0.019252 * f_z(ibs, 0.882598, 0.084759) + 0.085670 * f_z(rvol, 0.006785, 0.362272) + 0.015508 * f_z(roc21, 0.076308, 0.060199) + 0.011462 * f_z(roc63, 0.126912, 0.126937) - 0.138167 * f_z(roc126, 0.194445, 0.204811) + 0.070436 * f_z(atrPct, 1.611930, 0.716586) + 0.027211 * f_z(rsi14, 69.835997, 6.166192) - 0.000945 * f_z(ext50, 4.182523, 1.817074) + 0.079303 * f_z(rs63, 0.066475, 0.119643) - 0.027613 * f_z(dist52, -0.021203, 0.041455) - 0.067073 * f_z(bbwPct, 0.534123, 0.288047) - 0.009771 * f_z(gapAtr, 0.222340, 0.541392) - 0.019720 * f_z(spyUp, 0.956245, 0.204550) - 0.158138 * f_z(spyRoc63, 0.060437, 0.050798) - 0.000539 * f_z(rangeAtr, 1.049130, 0.486329) + 0.039462 * f_z(brkAtr, 0.488648, 0.463664) - 0.132061 * f_z(er20, 0.392134, 0.179705)
    => float(na)
thrYear   = switch fitYear
    2015 => 0.347398
    2016 => 0.337838
    2017 => 0.321030
    2018 => 0.381777
    2019 => 0.378296
    2020 => 0.358101
    2021 => 0.376900
    2022 => 0.382698
    2023 => 0.378597
    2024 => 0.380098
    2025 => 0.387874
    2026 => 0.391499
    => float(na)
scoreOos  = time > TRAIN_END ? scoreIs : scoreYear
thrOos    = time > TRAIN_END ? FINAL_THR : thrYear
score     = scoreOos  // the signals use the out-of-sample score
quality   = 1 / (1 + math.exp(-scoreOos))
qualityIs = 1 / (1 + math.exp(-scoreIs))
// minQual is an absolute threshold for the final fit; on OOS bars the same shift is applied to that year's own threshold
qualityOk   = not useModel or (not na(quality) and quality * 100 >= thrOos * 100 + (minQual - FINAL_THR * 100))
qualityOkIs = not useModel or (not na(qualityIs) and qualityIs * 100 >= minQual)
// <</GEN:MODEL>>

// next earnings report: only meaningful on recent bars (TradingView gives the upcoming date only)
nextEarn   = earnings.future_time
daysToEarn = na(nextEarn) ? na : (nextEarn - time_close) / 86400000.0
earnSoon   = earnDays > 0 and not na(daysToEarn) and daysToEarn >= 0 and daysToEarn <= earnDays
earnOk     = not (earnBlock and earnSoon)
isCand    = close > hiN and close > trendMa and ibs >= ibsMin
// <<GEN:REGIME>>
// v4 regime rule = swing4/final_spec.json (frozen 2026-10-22, before the single holdout run); accepted at 0.00 / 0.03 / 0.06, the middle was chosen
REGIME_MAX = 0.0300
// <</GEN:REGIME>>
regimeOk  = not useRegime or (not na(spyRoc63) and spyRoc63 <= REGIME_MAX)
// with the model on, rules other than the training rules select trades the model never saw: warn (step R3)
// research E30/E56: v3's edge per trade grows with a stock's typical volatility (1-year mean ATR%); v4.2 R2 caps it
atr1y = ta.sma(atr / close * 100, 252)
r1Ok  = not useR1 or spyUp == 1.0
r2Ok  = not useR2 or (not na(atr1y) and atr1y <= maxAtr1y)
paramsOff = useModel and (n != TRAIN_N or m != TRAIN_M or trailMult != TRAIN_TRAIL or ibsMin != TRAIN_IBS or trendLen != TRAIN_TREND)

// ---- signal state machine + per-chart trade statistics (same fills as the research engine) ----
// A function so the same code runs twice with its own `var` state: once with the OOS quality (the
// signals on the chart) and once with the in-sample quality (statistics only, for comparison).
// state: 0 flat, 1 entry pending (fills next open), 2 long, 3 exit pending
f_machine(bool entryOk) =>
    var int   state = 0
    var float hh = na
    var float stop = na
    var float tp = na
    var bool  halfOff = false
    var float entryPx = na
    var bool  counted = false
    var int   entryBar = na
    var int   nTr = 0
    var int   nWin = 0
    var float sumWin = 0.0
    var float sumLoss = 0.0
    var float sumRet = 0.0
    var float halfRet = na   // booked return of the half sold at the target (tpMult > 0)
    var float peak = na      // highest price since the fill, for the drawdown inside the trade
    var float tradeDD = 0.0
    var int   sumBars = 0
    var float sumDD = 0.0
    var float worstDD = 0.0
    var float eqSys = 1.0    // system equity at 100% of capital per trade, closed trades only (compounded)
    halfSig = false
    buySig  = false
    sellSig = false
    exited  = false  // the engine never re-enters on the bar it exits
    float exitPx = na
    if state == 3
        exitPx := open
        tradeDD := math.min(tradeDD, open / peak - 1)
        state := 0
        stop := na
        exited := true
    if state == 1
        entryPx := open
        counted := time >= statsFrom
        state := 2
        hh := high
        // drawdown inside a trade: intrabar order is unknown, so on EVERY bar the high is assumed to come before
        // the low (conservative); the fill bar's high counts because the fill is at the open
        peak := high
        tradeDD := math.min(0.0, low / high - 1)
        // protective stop from the fill itself: open - trailMult x ATR(signal bar); never hit in the 2015-26 tests,
        // but it covers a crash on the entry day (research E51)
        initStop = open - trailMult * atr[1]
        stop := math.max(initStop, hh - trailMult * atr)
        // the stop is checked before the target: if both are touched on one bar, the stop wins (conservative)
        if low <= initStop
            exitPx := initStop
            tradeDD := math.min(0.0, initStop / high - 1)  // flat at the stop: the path below it does not count
            sellSig := true
            state := 0
            stop := na
        tp := tpMult > 0 ? open + tpMult * atr[1] : na
        halfOff := false
        if state == 2 and tpMult > 0 and high >= tp
            halfSig := true
            halfOff := true
            halfRet := tp * (1 - costPct / 100) / (entryPx * (1 + costPct / 100)) - 1
        if state == 2 and close < loM
            sellSig := true
            state := 3
    else if state == 2
        // the stop is checked before the target: if both are touched on one bar, the stop wins (conservative)
        if low <= stop
            exitPx := math.min(open, stop)  // a gap below the stop fills at the open
            // stop inside the bar: the bar's high came first; gap below the stop: exit at the open, before the high
            tradeDD := math.min(tradeDD, exitPx / (open > stop ? math.max(peak, high) : peak) - 1)
            sellSig := true
            state := 0
            stop := na
        else
            if tpMult > 0 and not halfOff and high >= tp
                halfSig := true
                halfOff := true
                halfRet := math.max(open, tp) * (1 - costPct / 100) / (entryPx * (1 + costPct / 100)) - 1  // a gap above fills at the open
            peak := math.max(peak, high)
            tradeDD := math.min(tradeDD, low / peak - 1)
            hh := math.max(hh, high)
            stop := math.max(stop, hh - trailMult * atr)
            if close < loM
                sellSig := true
                state := 3
    if not na(exitPx) and counted
        rRest = exitPx * (1 - costPct / 100) / (entryPx * (1 + costPct / 100)) - 1
        // half sold at the target: the trade's return is 50% that half + 50% the rest (each pays its own exit cost)
        r = halfOff and not na(halfRet) ? 0.5 * halfRet + 0.5 * rRest : rRest
        nTr += 1
        nWin += r > 0 ? 1 : 0
        sumWin += math.max(r, 0)
        sumLoss += math.max(-r, 0)
        sumRet += r
        sumBars += bar_index - entryBar
        sumDD += tradeDD
        worstDD := math.min(worstDD, tradeDD)
        eqSys *= 1 + r
    if not na(exitPx)
        halfRet := na
    if state == 0 and isCand and entryOk and not sellSig and not exited
        buySig := true
        state := 1
        entryBar := bar_index + 1
    [state, stop, tp, halfOff, halfSig, buySig, sellSig, exited, entryBar, nTr, nWin, sumWin, sumLoss, sumRet, sumBars, sumDD, worstDD, exitPx, eqSys]

[state, stop, tp, halfOff, halfSig, buySig, sellSig, exited, entryBar, nTr, nWin, sumWin, sumLoss, sumRet, sumBars, sumDD, worstDD, sellPx, eqSys] = f_machine(qualityOk and earnOk and regimeOk and r1Ok and r2Ok)
[stIs, stopIs, tpIs, hoIs, hsIs, bsIs, ssIs, exIs, ebIs, nTrIs, nWinIs, sumWinIs, sumLossIs, sumRetIs, sbIs, sddIs, wddIs, pxIs, eqIs] = f_machine(qualityOkIs and earnOk and regimeOk and r1Ok and r2Ok)
// SELL kind: a stop (initial or trailing) fills inside the bar or at a gapped open (sellPx); a close below the prior
// m-day low only SIGNALS here and fills at the NEXT open (sellPx = na)
sellStop = sellSig and not na(sellPx)
sellTxt  = sellStop ? "stop, filled " + str.tostring(sellPx, format.mintick) : "close " + str.tostring(close, format.mintick) + " < " + str.tostring(m) + "d low: exit next open"

// ---- benchmarks over exactly the backtest window (first bar on or after statsFrom .. this bar), price returns ----
spyClose = request.security(spySym, "D", close)
var float c0 = na
var float spy0 = na
var int   bar0 = na
if time >= statsFrom and na(c0)
    c0 := close
    spy0 := spyClose
    bar0 := bar_index
bhRet    = close / c0 - 1
spyRet   = spyClose / spy0 - 1
winBars  = na(bar0) ? na : bar_index - bar0 + 1
openBars = (state == 2 or state == 3) ? bar_index - entryBar : 0
exposure = na(winBars) ? na : (sumBars + openBars) / winBars

plot(trendMa, "Trend SMA", color = color.new(color.gray, 40))
plot(state == 2 or state == 3 ? stop : na, "Trailing stop", color = color.red, style = plot.style_linebr)
// confirmed at the close vs provisional while the daily bar is still forming (can still disappear)
plotshape(buySig and barstate.isconfirmed and not showPx, "BUY", shape.labelup, location.belowbar, color.green, text = "BUY", textcolor = color.white)
// BUY / SELL with the price underneath (confirmed bars only). BUY: the signal close (the fill is the next open).
// SELL: the fill price when a stop was hit (inside the bar or a gapped open); "next open" for an m-day-low exit.
if showPx and barstate.isconfirmed and buySig
    label.new(bar_index, low, "BUY\n" + str.tostring(close, format.mintick), yloc = yloc.belowbar, style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)
if showPx and barstate.isconfirmed and sellSig
    label.new(bar_index, high, sellStop ? "SELL stop\n" + str.tostring(sellPx, format.mintick) : "SELL\nnext open", yloc = yloc.abovebar, style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)
plotshape(buySig and not barstate.isconfirmed, "BUY? (bar not closed)", shape.labelup, location.belowbar, color.new(color.green, 60), text = "BUY?", textcolor = color.white)
plot(tpMult > 0 and (state == 2 or state == 3) and not halfOff ? tp : na, "Half-profit target", color = color.teal, style = plot.style_linebr)
plotshape(halfSig, "½ PROFIT", shape.diamond, location.abovebar, color.teal, size = size.tiny, text = "½")
plotshape(sellSig and barstate.isconfirmed and not showPx, "SELL", shape.labeldown, location.abovebar, color.red, text = "SELL", textcolor = color.white)
plotshape(sellSig and not barstate.isconfirmed, "SELL? (bar not closed)", shape.labeldown, location.abovebar, color.new(color.red, 60), text = "SELL?", textcolor = color.white)
// breakouts the v4 regime rule blocked (the model would have taken them)
plotshape(state == 0 and isCand and qualityOk and not regimeOk and not sellSig and not exited,
     "Blocked by regime (SPY strong)", shape.triangleup, location.belowbar, color.new(color.gray, 20), size = size.tiny)
// breakouts the model rejected, for context
plotshape(useModel and state == 0 and isCand and not qualityOk and not na(quality) and not sellSig and not exited,
     "Rejected breakout", shape.xcross, location.belowbar, color.new(color.orange, 30), size = size.tiny)
plot(quality, "Breakout quality (0-1)", display = display.data_window)
// for TradingView's Pine Screener: filter a whole watchlist on "Status" = 1 (new BUY) or -1 (SELL)
statusCode = buySig ? 1 : sellSig ? -1 : (state == 2 or state == 3) ? 2 : 0
plot(statusCode, "Status (1 BUY, -1 SELL, 2 long, 0 flat)", display = display.data_window)
// <<GEN:DEBUG>>
plot(debugFeat ? ibs : na, "f ibs", display = display.data_window)
plot(debugFeat ? rvol : na, "f rvol", display = display.data_window)
plot(debugFeat ? roc21 : na, "f roc21", display = display.data_window)
plot(debugFeat ? roc63 : na, "f roc63", display = display.data_window)
plot(debugFeat ? roc126 : na, "f roc126", display = display.data_window)
plot(debugFeat ? atrPct : na, "f atr_pct", display = display.data_window)
plot(debugFeat ? rsi14 : na, "f rsi14", display = display.data_window)
plot(debugFeat ? ext50 : na, "f ext50", display = display.data_window)
plot(debugFeat ? rs63 : na, "f rs63", display = display.data_window)
plot(debugFeat ? dist52 : na, "f dist52", display = display.data_window)
plot(debugFeat ? bbwPct : na, "f bbw_pct", display = display.data_window)
plot(debugFeat ? gapAtr : na, "f gap", display = display.data_window)
plot(debugFeat ? spyUp : na, "f spy_up", display = display.data_window)
plot(debugFeat ? spyRoc63 : na, "f spy_roc63", display = display.data_window)
plot(debugFeat ? rangeAtr : na, "f range_atr", display = display.data_window)
plot(debugFeat ? brkAtr : na, "f brk_atr", display = display.data_window)
plot(debugFeat ? er20 : na, "f er20", display = display.data_window)
plot(debugFeat ? score : na, "f score (logit)", display = display.data_window)
// <</GEN:DEBUG>>

// ---- info table (last bar) ----
// position size for a new BUY: risk riskPct of the account between the next open (~close) and the initial stop,
// capped at maxPosPct of the account (research: ~10 positions on volatile names).
// ESTIMATE: the fill (next open) is not known yet, so the stop is estimated from today's close. The real stop is
// fill - trailMult x ATR(signal bar) = fill - stopDist: recompute it (and the size) once you are filled.
stopDist = trailMult * atr
estStop  = close - stopDist
riskPerSh = close - estStop
sizeSh   = riskPerSh > 0 ? math.floor(math.min(acctSize * riskPct / 100 / riskPerSh, acctSize * maxPosPct / 100 / close)) : 0


// chart statistics text; "OOS" = every trade was selected by a model fitted only on trades that closed before
// that bar's year (walk-forward). The in-sample row uses the final fit, which has seen these years: optimistic.
f_statTxt(int k, int w, float sw, float sl, float sr) =>
    pfx = sl > 0 ? sw / sl : na
    k == 0 ? "no closed trades" : str.tostring(k) + " trades | win " + str.tostring(100.0 * w / k, "#") + "% | PF " + (na(pfx) ? "∞" : str.tostring(pfx, "#.##")) + " | avg " + str.tostring(100 * sr / k, "#.#") + "%"

var table info = table.new(position.top_right, 2, 20, bgcolor = color.new(color.black, 80), frame_color = color.new(color.gray, 60), frame_width = 1, border_width = 0)
tSize = tblSize == "tiny" ? size.tiny : tblSize == "small" ? size.small : size.normal
f_row(int r, string k, string v, color vc, color bg) =>
    table.cell(info, 0, r, k, text_color = color.white, text_size = tSize, text_halign = text.align_left)
    table.cell(info, 1, r, v, text_color = vc, bgcolor = bg, text_size = tSize, text_halign = text.align_left)
if showTable and barstate.islast
    table.clear(info, 0, 0, 1, 19)
    inTrade = state == 2 or state == 3
    statusTxt = state == 1 ? "BUY (fill next open)" : state == 3 ? "SELL (exit next open)" : inTrade ? "LONG" : sellSig ? "SOLD" : "flat"
    statusCol = state == 1 or inTrade ? color.green : sellSig ? color.red : color.gray
    // quality is na while any model feature is missing: usually too little history (the longest feature needs ~200
    // bars, the full 52-week window 252), otherwise a data gap (Debug input shows which feature is na)
    qualNa  = useModel and na(quality)
    qualTxt = qualNa ? (bar_index + 1 < 252 ? "te weinig historie (" + str.tostring(bar_index + 1) + "/252)" : "feature missing") : isCand ? str.tostring(quality * 100, "#") + "% " + (qualityOk ? "ok" : "too low") : "no breakout"
    pfAll   = sumLoss > 0 ? sumWin / sumLoss : na
    r = 0
    f_row(r, "Swing v4.2", statusTxt, color.white, color.new(statusCol, 40))
    r += 1
    f_row(r, "Quality", qualTxt, qualNa ? color.yellow : not isCand ? color.gray : qualityOk ? color.lime : color.orange, na)
    r += 1
    f_row(r, "Regime", na(spyRoc63) ? "n/a" : "SPY 63d " + str.tostring(spyRoc63 * 100, "#.#") + "% " + (regimeOk ? "ok" : "blocked"), regimeOk ? color.lime : color.orange, na)
    r += 1
    if inTrade
        f_row(r, "Stop", str.tostring(stop, format.mintick) + " (" + str.tostring((close - stop) / close * 100, "#.#") + "%)", color.white, na)
        r += 1
    // not out-of-sample: only the model coefficients are walk-forward; the rules were chosen on this history
    f_row(r, "Backtest " + str.format_time(statsFrom, "yyyy") + "+", nTr == 0 ? "no trades" : str.tostring(nTr) + " tr | " + str.tostring(100.0 * nWin / nTr, "#") + "% | PF " + (na(pfAll) ? "∞" : str.tostring(pfAll, "#.#")), color.white, na)
    r += 1
    f_row(r, "vs B&H (prijs)", na(c0) ? "n/a" : "sys " + str.tostring(100 * (eqSys - 1), "#") + "% | aandeel " + str.tostring(100 * bhRet, "#") + "% | SPY " + str.tostring(100 * spyRet, "#") + "%", eqSys - 1 >= bhRet ? color.lime : color.orange, na)
    r += 1
    f_row(r, "In trade", na(exposure) ? "n/a" : str.tostring(100 * exposure, "#") + "% of bars (100%/trade)", color.white, na)
    r += 1
    if paramsOff
        f_row(r, "⚠ Settings", TRAIN_TXT, color.black, color.yellow)
        r += 1
    if not timeframe.isdaily
        f_row(r, "Chart", "use a DAILY chart!", color.black, color.yellow)
        r += 1
    if fullTable
        f_row(r, "Note", "model walk-forward; rules + regime chosen on 2015-24 = in-sample; price returns, no dividends", color.gray, na)
        r += 1
        f_row(r, "Backtest detail", f_statTxt(nTr, nWin, sumWin, sumLoss, sumRet), color.white, na)
        r += 1
        f_row(r, "Per trade", nTr == 0 ? "-" : "DD worst " + str.tostring(100 * worstDD, "#.#") + "% avg " + str.tostring(100 * sumDD / nTr, "#.#") + "% | hold " + str.tostring(sumBars / nTr, "#") + " bars", color.white, na)
        r += 1
        f_row(r, "Bars in trade", inTrade ? str.tostring(bar_index - entryBar + 1) : "-", color.white, na)
        r += 1
        f_row(r, "Size (geschat)", str.tostring(sizeSh) + " sh | stop ~" + str.tostring(estStop, format.mintick) + " = fill − " + str.tostring(stopDist, format.mintick), color.white, na)
        r += 1
        f_row(r, "Next earnings", na(daysToEarn) ? "n/a" : str.tostring(math.round(daysToEarn)) + " days", earnSoon ? color.yellow : color.white, na)
        r += 1
        f_row(r, "Trend SMA" + str.tostring(trendLen), close > trendMa ? "up" : "down", close > trendMa ? color.lime : color.red, na)
        r += 1
        // v3.1 portfolio rule (research E48): keep idle cash in SPY while SPY > its 200-day SMA, else in cash
        f_row(r, "Idle cash → SPY", spyUp == 1.0 ? "yes (SPY > SMA200)" : "no, hold cash", spyUp == 1.0 ? color.lime : color.orange, na)
        r += 1
        f_row(r, "Volatility 1y", na(atr1y) ? "n/a" : str.tostring(atr1y, "#.#") + "% " + (atr1y >= 2.5 ? "good fit" : atr1y >= 1.5 ? "ok fit" : "weak fit"), na(atr1y) ? color.gray : atr1y >= 2.5 ? color.lime : atr1y >= 1.5 ? color.white : color.orange, na)
        r += 1
        if showIS
            f_row(r, "In-sample", f_statTxt(nTrIs, nWinIs, sumWinIs, sumLossIs, sumRetIs) + " (optimistic)", color.gray, na)
            r += 1

// earnings warning on a fresh BUY (research E38: entries in the week before earnings were weaker)
plotshape(buySig and earnSoon, "BUY near earnings", shape.circle, location.belowbar, color.yellow, size = size.tiny)

if buySig
    alert("Swing v4.2 BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | stop after fill: fill - " + str.tostring(stopDist, format.mintick) + " (geschat ~" + str.tostring(estStop, format.mintick) + ")" + " | quality " + str.tostring(quality * 100, "#") + "% | size " + str.tostring(sizeSh) + " sh (geschat)" + (earnSoon ? " | WARNING: earnings in " + str.tostring(math.round(daysToEarn)) + " days" : ""), alert.freq_once_per_bar_close)
if sellSig
    alert("Swing v4.2 SELL " + syminfo.ticker + ": " + sellTxt, alert.freq_once_per_bar_close)

alertcondition(buySig, "Swing v4.2 BUY", "Swing v4.2 BUY on {{ticker}} at {{close}} (fills next open)")
alertcondition(halfSig, "Swing v4.2 HALF PROFIT", "Swing v4.2: take half profit on {{ticker}}")
alertcondition(sellSig and sellStop, "Swing v4.2 SELL (stop hit)", "Swing v4.2 SELL on {{ticker}}: stop hit today")
alertcondition(sellSig and not sellStop, "Swing v4.2 SELL (exit next open)", "Swing v4.2 SELL on {{ticker}}: close {{close}} below the 20-day low, exit at the next open")
