//@version=5
// Swing buy/sell indicator v4.1 = v4 with the phase-1 audit fixes, SIGNALS UNCHANGED on US charts:
//  - the table no longer calls the chart statistics "OOS": only the model coefficients are walk-forward; the rules,
//    the threshold and the regime rule were chosen on this same 2015-2024 history (in-sample).
//  - benchmark rows: system return compounded at 100% per trade, buy & hold of this stock and of SPY over exactly
//    the same window, and the exposure (share of bars in a trade). All PRICE returns (no dividends).
//  - SELL label and alert say the same thing: a stop exit shows its fill price; a 20-day-low exit shows that it fills
//    at the NEXT open (the close is only a reference).
//  - the earnings block is labelled live-only (TradingView only knows the next date, so it cannot be backtested).
//  - non-US charts: on a US holiday SPY has no bar, and the previous SPY day is used instead of two days back.
// Swing v4 — v3 (Donchian 20/20 breakout + strong close + 4xATR trail + quality model)
// v4 = v3 + ONE market-regime rule from the swing v4 research round (indicator_lab/swing4, see reports/):
// only take a breakout when SPY's 63-day return at the signal close is <= 3% (breakouts after a flat or weak
// market lead the next leg; after a strong 3-month market run a new breakout is usually late).
// Single holdout run (84 never-used tickers + the last 2 years): v4 beat v3 on win rate, expectancy and MAR in
// every cell, but on that clean data neither v3 nor v4 beat buy & hold of SPY. Profit-taking exits (partials,
// break-even, tighter trail, time stop) were tested and rejected: they cut the few big winners that carry the P&L.
// The v3 part: breakouts filtered by a logistic "breakout quality" model (meta-labeling).
// Port of indicator_lab/meta.py::meta_breakout {"n":20,"m":20,"trail":4.0,"ibs_min":0.7,"keep":0.75,"l2":100}.
// The <<GEN:...>> regions are generated by `python -m indicator_lab.export_pine` from
// indicator_lab/pine/v3_model.json + v3_model_yearly.json — do not edit them by hand.
// Signals on history use the walk-forward (out-of-sample) fit of each bar's year; see the MODEL region.
// BUY = signal at this close, enter next open. SELL = close below prior m-day low (exit next open)
// or trailing stop touched (exit at stop). Daily chart. Not financial advice.
indicator("Swing v4.2 – v4.1 + extra filters (see header)", overlay = true, max_labels_count = 500)

// <<GEN:TRAIN>>
// The quality model was trained on breakouts with exactly these rules (v3_model.json "params"); the inputs
// default to them, and with the model on, any other value gets a warning (the model never saw those trades).
TRAIN_N     = 20
TRAIN_M     = 20
TRAIN_TRAIL = 4.00
TRAIN_IBS   = 0.70
TRAIN_TREND = 200
TRAIN_TXT   = "model getraind op n=20/m=20/trail=4/ibs=0.7/SMA200"
// Threshold of the final fit = v3_model.json "thr" 0.393009: the 25th percentile of its
// predictions on its own 3633 training breakouts (keep 0.75). minQual defaults to it (in %).
FINAL_THR   = 0.393009
// <</GEN:TRAIN>>

// v4.2 filter defaults: set from indicator_lab/swing7/reports (draft: off until the round is finished)
R1_DEF = false
R2_DEF = false

n         = input.int(TRAIN_N, "Breakout lookback (days)", minval = 2)
m         = input.int(TRAIN_M, "Exit lookback (days)", minval = 2)
trailMult = input.float(TRAIN_TRAIL, "Trail (x ATR14)", minval = 0.5, step = 0.25)
trendLen  = input.int(TRAIN_TREND, "Trend filter SMA", minval = 10)
ibsMin    = input.float(TRAIN_IBS, "Min close position in day range (0-1)", minval = 0, maxval = 1, step = 0.05)
useModel  = input.bool(true, "Use quality model (v3); off = v2")
useRegime = input.bool(true, "v4 regime rule: only BUY when SPY's 63-day return <= REGIME_MAX")
minQual   = input.float(FINAL_THR * 100, "Min breakout quality % (default = model threshold; higher = stricter)", minval = 0, maxval = 100, step = 1)
spySym    = input.symbol("AMEX:SPY", "Market reference")
tpMult    = input.float(0.0, "Take half profit at +x ATR (0 = off; research E22 used 4)", minval = 0, step = 0.5)
earnDays  = input.int(7, "Earnings warning window (calendar days, 0 = off)", minval = 0)
earnBlock = input.bool(false, "Block BUY inside the earnings window (LIVE ONLY: not in the history/statistics, untested as a rule)")
showTable = input.bool(true, "Show info table")
fullTable = input.bool(false, "Full table (all rows); off = compact")
tblSize   = input.string("small", "Table text size", options = ["tiny", "small", "normal"])
showPx    = input.bool(true, "Show the price under BUY / SELL")
acctSize  = input.float(10000, "Account size (for position size)", minval = 0, group = "Position size")
riskPct   = input.float(1.0, "Risk per trade (% of account)", minval = 0.05, step = 0.25, group = "Position size")
maxPosPct = input.float(10.0, "Max position (% of account; ~10 positions)", minval = 1, maxval = 100, group = "Position size")
statsFrom = input.time(timestamp("2015-01-01"), "Count trades from (window of the backtest and the benchmarks)", group = "Chart statistics")
costPct   = input.float(0.1, "Cost per side % (commission + slippage)", minval = 0, step = 0.05, group = "Chart statistics")
showIS    = input.bool(false, "Also show the in-sample statistics (final fit; optimistic)", group = "Chart statistics")
debugFeat = input.bool(false, "Debug: show the raw model features in the Data Window", group = "Debug")
useR1     = input.bool(R1_DEF, "R1: only BUY when SPY > its SMA200", group = "v4.2 filters")
useR2     = input.bool(R2_DEF, "R2: only BUY when the 1-year mean ATR% <= max", group = "v4.2 filters")
maxAtr1y  = input.float(5.0, "R2: max 1-year mean ATR%", minval = 0.5, step = 0.5, group = "v4.2 filters")

// <<GEN:HELPERS>>
// Python (meta.feature_frame, pandas) is the reference for every model feature; pine_parity.py checks it.
// ta.rma seeds with an SMA, pandas ewm(adjust=False) with the first value: this reproduces pandas.
f_rma_py(float src, simple int len) =>
    var float s = na
    var int cnt = 0
    if not na(src)
        s := na(s) ? src : (src + (len - 1) * s) / len
        cnt += 1
    cnt >= len ? s : na

// pandas rolling(len, min_periods = minCnt).rank(pct = True): current bar included, ties averaged
// (ta.percentrank counts only the PREVIOUS len values).
f_rank_incl(float x, simple int len, simple int minCnt) =>
    float res = na
    if not na(x)
        int cnt = 0
        int less = 0
        int eq = 0
        for i = 0 to len - 1
            v = x[i]
            if not na(v)
                cnt += 1
                less += v < x ? 1 : 0
                eq += v == x ? 1 : 0
        res := cnt >= minCnt ? (less + (eq + 1) / 2.0) / cnt : na
    res

// SPY's 63-day return and its SMA200 trend, computed on SPY's OWN daily bars (lookbacks in SPY trading days, also
// when the chart is on another exchange with other holidays) + the same values one SPY day earlier.
f_spyFeat() =>
    roc = close / close[63] - 1
    ma  = ta.sma(close, 200)
    up  = na(ma) ? na : close > ma ? 1.0 : 0.0
    [roc, up, roc[1], up[1]]

// No nz(): a missing feature makes the score na, so quality is na and there is no BUY (the training dropped
// such rows instead of imputing them; R4 found no taken trade with a missing feature in Python either).
f_z(x, mu, sd) => (x - mu) / sd
// <</GEN:HELPERS>>

// ---- model features (all known at this bar's close) ----
// <<GEN:FEATURES>>
trueRange = na(close[1]) ? high - low : math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
atr       = f_rma_py(trueRange, 14)
chg       = ta.change(close)
rsiUp     = f_rma_py(na(chg) ? na : math.max(chg, 0), 14)
rsiDn     = f_rma_py(na(chg) ? na : math.max(-chg, 0), 14)
[spyRoc0, spyUp0, spyRoc1, spyUp1] = request.security(spySym, "D", f_spyFeat())
// Outside New York the chart's bar closes before SPY's bar of the same date: use the previous SPY day (no look-ahead)
spyUS     = syminfo.timezone == "America/New_York"
spyYmd    = request.security(spySym, "D", year * 10000 + month * 100 + dayofmonth)
// SPY bar from an earlier date than this chart bar (US holiday): it closed before this bar, so use it as is
spyLag0   = spyUS or spyYmd < year * 10000 + month * 100 + dayofmonth
volRatio  = volume / ta.sma(volume, 50)
ibs       = high > low ? (close - low) / (high - low) : 0.5
rvol      = na(volRatio) ? na : math.log(math.max(volRatio, 0.05))
roc21     = close / close[21] - 1
roc63     = close / close[63] - 1
roc126    = close / close[126] - 1
atrPct    = atr / close * 100
rsi14     = na(rsiUp) or na(rsiDn) ? na : rsiDn == 0 ? 100.0 : 100 - 100 / (1 + rsiUp / rsiDn)
ext50     = (close - ta.sma(close, 50)) / atr
spyRoc63  = spyLag0 ? spyRoc0 : spyRoc1
rs63      = roc63 - spyRoc63
hi52      = bar_index >= 199 ? ta.highest(high, math.min(bar_index + 1, 252)) : na
dist52    = close / hi52 - 1
bbw       = 4 * ta.stdev(close, 20) / ta.sma(close, 20)
bbwPct    = f_rank_incl(bbw, 252, 100)
gapAtr    = (open - close[1]) / atr[1]
spyUp     = spyLag0 ? spyUp0 : spyUp1
rangeAtr  = (high - low) / atr[1]
brkAtr    = (close - ta.highest(high, TRAIN_N)[1]) / atr  // feature definition: the TRAINING lookback, not input n
er20      = math.abs(close - close[20]) / math.sum(math.abs(ta.change(close)), 20)
// <</GEN:FEATURES>>

trendMa = ta.sma(close, trendLen)
hiN     = ta.highest(high, n)[1]
loM     = ta.lowest(low, m)[1]

// <<GEN:MODEL>>
// FINAL fit: 3633 closed DEV breakouts up to 2026-10-20.
scoreIs = -0.243512 - 0.012028 * f_z(ibs, 0.882207, 0.084672) + 0.077133 * f_z(rvol, 0.003919, 0.361995) + 0.015587 * f_z(roc21, 0.077099, 0.060410) + 0.016426 * f_z(roc63, 0.126093, 0.125672) - 0.139563 * f_z(roc126, 0.194343, 0.202689) + 0.049966 * f_z(atrPct, 1.623357, 0.713240) + 0.026913 * f_z(rsi14, 69.836667, 6.165982) - 0.021419 * f_z(ext50, 4.176703, 1.826246) + 0.089082 * f_z(rs63, 0.066030, 0.118733) - 0.014834 * f_z(dist52, -0.021020, 0.041071) - 0.046283 * f_z(bbwPct, 0.542481, 0.289020) - 0.015639 * f_z(gapAtr, 0.222430, 0.543220) - 0.010637 * f_z(spyUp, 0.958161, 0.200220) - 0.169306 * f_z(spyRoc63, 0.060063, 0.050280) - 0.010604 * f_z(rangeAtr, 1.051659, 0.484647) + 0.053239 * f_z(brkAtr, 0.487312, 0.462300) - 0.134906 * f_z(er20, 0.391484, 0.180468)
// OOS: on history each bar uses the walk-forward fit of its own year, trained only on breakouts whose
// trade closed before 1 Jan of that year (v3_model_yearly.json). Bars after TRAIN_END (the last bar
// the final fit has seen) use the final fit. Before the first fit year there is no model (no BUY).
TRAIN_END = timestamp("UTC", 2026, 10, 20, 23, 59)
fitYear   = year(time)
scoreYear = switch fitYear
    2015 => -0.405449 + 0.074646 * f_z(ibs, 0.887154, 0.085169) + 0.062733 * f_z(rvol, -0.004906, 0.390531) + 0.020430 * f_z(roc21, 0.062693, 0.053731) - 0.061505 * f_z(roc63, 0.109502, 0.127008) - 0.080234 * f_z(roc126, 0.179468, 0.164466) + 0.029252 * f_z(atrPct, 1.416531, 0.586139) - 0.056083 * f_z(rsi14, 69.124762, 5.738042) + 0.079374 * f_z(ext50, 3.982247, 1.774177) - 0.011267 * f_z(rs63, 0.049675, 0.125051) - 0.033240 * f_z(dist52, -0.014326, 0.035715) + 0.069605 * f_z(bbwPct, 0.537074, 0.297719) + 0.070044 * f_z(gapAtr, 0.196658, 0.684831) - 0.214465 * f_z(spyRoc63, 0.059827, 0.029854) - 0.088632 * f_z(rangeAtr, 1.047951, 0.498495) - 0.008407 * f_z(brkAtr, 0.470025, 0.487755) - 0.144123 * f_z(er20, 0.370543, 0.176825)
