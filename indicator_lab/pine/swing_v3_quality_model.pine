    2025 => -0.260770 - 0.019082 * f_z(ibs, 0.882872, 0.084818) + 0.102035 * f_z(rvol, 0.002929, 0.363919) + 0.013368 * f_z(roc21, 0.075727, 0.060771) + 0.021672 * f_z(roc63, 0.126809, 0.128326) - 0.108731 * f_z(roc126, 0.197403, 0.207946) + 0.009804 * f_z(atrPct, 1.600578, 0.719850) + 0.037091 * f_z(rsi14, 69.819260, 6.203170) - 0.014531 * f_z(ext50, 4.179224, 1.833467) + 0.088743 * f_z(rs63, 0.067080, 0.121457) - 0.033772 * f_z(dist52, -0.020920, 0.041862) - 0.062470 * f_z(bbwPct, 0.534965, 0.286625) - 0.012889 * f_z(gapAtr, 0.220759, 0.541902) - 0.038562 * f_z(spyUp, 0.955136, 0.207005) - 0.159447 * f_z(spyRoc63, 0.059729, 0.050157) - 0.007294 * f_z(rangeAtr, 1.051341, 0.488001) + 0.039258 * f_z(brkAtr, 0.488918, 0.464144) - 0.152381 * f_z(er20, 0.391098, 0.179489)
    2026 => -0.245655 - 0.019252 * f_z(ibs, 0.882598, 0.084759) + 0.085670 * f_z(rvol, 0.006785, 0.362272) + 0.015508 * f_z(roc21, 0.076308, 0.060199) + 0.011462 * f_z(roc63, 0.126912, 0.126937) - 0.138167 * f_z(roc126, 0.194445, 0.204811) + 0.070436 * f_z(atrPct, 1.611930, 0.716586) + 0.027211 * f_z(rsi14, 69.835997, 6.166192) - 0.000945 * f_z(ext50, 4.182523, 1.817074) + 0.079303 * f_z(rs63, 0.066475, 0.119643) - 0.027613 * f_z(dist52, -0.021203, 0.041455) - 0.067073 * f_z(bbwPct, 0.534123, 0.288047) - 0.009771 * f_z(gapAtr, 0.222340, 0.541392) - 0.019720 * f_z(spyUp, 0.956245, 0.204550) - 0.158138 * f_z(spyRoc63, 0.060437, 0.050798) - 0.000539 * f_z(rangeAtr, 1.049130, 0.486329) + 0.039462 * f_z(brkAtr, 0.488648, 0.463664) - 0.132061 * f_z(er20, 0.392134, 0.179705)
    => float(na)
thrYear   = switch fitYear
    2015 => 0.347398
    2016 => 0.337838
    2017 => 0.321030
    2018 => 0.381777
    2019 => 0.378296
    2020 => 0.358101
    2021 => 0.376900
    2022 => 0.382698
    2023 => 0.378597
    2024 => 0.380098
    2025 => 0.387874
    2026 => 0.391499
    => float(na)
scoreOos  = time > TRAIN_END ? scoreIs : scoreYear
thrOos    = time > TRAIN_END ? FINAL_THR : thrYear
score     = scoreOos  // the signals use the out-of-sample score
quality   = 1 / (1 + math.exp(-scoreOos))
qualityIs = 1 / (1 + math.exp(-scoreIs))
// minQual is an absolute threshold for the final fit; on OOS bars the same shift is applied to that year's own threshold
qualityOk   = not useModel or (not na(quality) and quality * 100 >= thrOos * 100 + (minQual - FINAL_THR * 100))
qualityOkIs = not useModel or (not na(qualityIs) and qualityIs * 100 >= minQual)
// <</GEN:MODEL>>

// next earnings report: only meaningful on recent bars (TradingView gives the upcoming date only)
nextEarn   = earnings.future_time
daysToEarn = na(nextEarn) ? na : (nextEarn - time_close) / 86400000.0
earnSoon   = earnDays > 0 and not na(daysToEarn) and daysToEarn >= 0 and daysToEarn <= earnDays
earnOk     = not (earnBlock and earnSoon)
isCand    = close > hiN and close > trendMa and ibs >= ibsMin
// with the model on, rules other than the training rules select trades the model never saw: warn (step R3)
paramsOff = useModel and (n != TRAIN_N or m != TRAIN_M or trailMult != TRAIN_TRAIL or ibsMin != TRAIN_IBS or trendLen != TRAIN_TREND)

// ---- signal state machine + per-chart trade statistics (same fills as the research engine) ----
// A function so the same code runs twice with its own `var` state: once with the OOS quality (the
// signals on the chart) and once with the in-sample quality (statistics only, for comparison).
// state: 0 flat, 1 entry pending (fills next open), 2 long, 3 exit pending
f_machine(bool entryOk) =>
    var int   state = 0
    var float hh = na
    var float stop = na
    var float tp = na
    var bool  halfOff = false
    var float entryPx = na
    var bool  counted = false
    var int   entryBar = na
    var int   nTr = 0
    var int   nWin = 0
    var float sumWin = 0.0
    var float sumLoss = 0.0
    var float sumRet = 0.0
    halfSig = false
    buySig  = false
    sellSig = false
    exited  = false  // the engine never re-enters on the bar it exits
    float exitPx = na
    if state == 3
        exitPx := open
        state := 0
        stop := na
        exited := true
    if state == 1
        entryPx := open
        counted := time >= statsFrom
        state := 2
        hh := high
        // protective stop from the fill itself: open - trailMult x ATR(signal bar); never hit in the 2015-26 tests,
        // but it covers a crash on the entry day (research E51)
        initStop = open - trailMult * atr[1]
        stop := math.max(initStop, hh - trailMult * atr)
        if low <= initStop
            exitPx := initStop
            sellSig := true
            state := 0
            stop := na
        tp := tpMult > 0 ? open + tpMult * atr[1] : na
        halfOff := false
        if state == 2 and tpMult > 0 and high >= tp
            halfSig := true
            halfOff := true
        if state == 2 and close < loM
            sellSig := true
            state := 3
    else if state == 2
        if low <= stop
            exitPx := math.min(open, stop)  // a gap below the stop fills at the open
            sellSig := true
            state := 0
            stop := na
        else
            if tpMult > 0 and not halfOff and high >= tp
                halfSig := true
                halfOff := true
            hh := math.max(hh, high)
            stop := math.max(stop, hh - trailMult * atr)
            if close < loM
                sellSig := true
                state := 3
    if not na(exitPx) and counted
        r = exitPx * (1 - costPct / 100) / (entryPx * (1 + costPct / 100)) - 1
        nTr += 1
        nWin += r > 0 ? 1 : 0
        sumWin += math.max(r, 0)
        sumLoss += math.max(-r, 0)
        sumRet += r
    if state == 0 and isCand and entryOk and not sellSig and not exited
        buySig := true
        state := 1
        entryBar := bar_index + 1
    [state, stop, tp, halfOff, halfSig, buySig, sellSig, exited, entryBar, nTr, nWin, sumWin, sumLoss, sumRet]

[state, stop, tp, halfOff, halfSig, buySig, sellSig, exited, entryBar, nTr, nWin, sumWin, sumLoss, sumRet] = f_machine(qualityOk and earnOk)
[stIs, stopIs, tpIs, hoIs, hsIs, bsIs, ssIs, exIs, ebIs, nTrIs, nWinIs, sumWinIs, sumLossIs, sumRetIs] = f_machine(qualityOkIs and earnOk)

plot(trendMa, "Trend SMA", color = color.new(color.gray, 40))
plot(state == 2 or state == 3 ? stop : na, "Trailing stop", color = color.red, style = plot.style_linebr)
// confirmed at the close vs provisional while the daily bar is still forming (can still disappear)
plotshape(buySig and barstate.isconfirmed, "BUY", shape.labelup, location.belowbar, color.green, text = "BUY", textcolor = color.white)
plotshape(buySig and not barstate.isconfirmed, "BUY? (bar not closed)", shape.labelup, location.belowbar, color.new(color.green, 60), text = "BUY?", textcolor = color.white)
plot(tpMult > 0 and (state == 2 or state == 3) and not halfOff ? tp : na, "Half-profit target", color = color.teal, style = plot.style_linebr)
plotshape(halfSig, "½ PROFIT", shape.diamond, location.abovebar, color.teal, size = size.tiny, text = "½")
plotshape(sellSig and barstate.isconfirmed, "SELL", shape.labeldown, location.abovebar, color.red, text = "SELL", textcolor = color.white)
plotshape(sellSig and not barstate.isconfirmed, "SELL? (bar not closed)", shape.labeldown, location.abovebar, color.new(color.red, 60), text = "SELL?", textcolor = color.white)
// breakouts the model rejected, for context
plotshape(useModel and state == 0 and isCand and not qualityOk and not sellSig and not exited,
     "Rejected breakout", shape.xcross, location.belowbar, color.new(color.orange, 30), size = size.tiny)
plot(quality, "Breakout quality (0-1)", display = display.data_window)
// for TradingView's Pine Screener: filter a whole watchlist on "Status" = 1 (new BUY) or -1 (SELL)
statusCode = buySig ? 1 : sellSig ? -1 : (state == 2 or state == 3) ? 2 : 0
plot(statusCode, "Status (1 BUY, -1 SELL, 2 long, 0 flat)", display = display.data_window)
// <<GEN:DEBUG>>
plot(debugFeat ? ibs : na, "f ibs", display = display.data_window)
plot(debugFeat ? rvol : na, "f rvol", display = display.data_window)
plot(debugFeat ? roc21 : na, "f roc21", display = display.data_window)
plot(debugFeat ? roc63 : na, "f roc63", display = display.data_window)
plot(debugFeat ? roc126 : na, "f roc126", display = display.data_window)
plot(debugFeat ? atrPct : na, "f atr_pct", display = display.data_window)
plot(debugFeat ? rsi14 : na, "f rsi14", display = display.data_window)
plot(debugFeat ? ext50 : na, "f ext50", display = display.data_window)
plot(debugFeat ? rs63 : na, "f rs63", display = display.data_window)
plot(debugFeat ? dist52 : na, "f dist52", display = display.data_window)
plot(debugFeat ? bbwPct : na, "f bbw_pct", display = display.data_window)
plot(debugFeat ? gapAtr : na, "f gap", display = display.data_window)
plot(debugFeat ? spyUp : na, "f spy_up", display = display.data_window)
plot(debugFeat ? spyRoc63 : na, "f spy_roc63", display = display.data_window)
plot(debugFeat ? rangeAtr : na, "f range_atr", display = display.data_window)
plot(debugFeat ? brkAtr : na, "f brk_atr", display = display.data_window)
plot(debugFeat ? er20 : na, "f er20", display = display.data_window)
plot(debugFeat ? score : na, "f score (logit)", display = display.data_window)
// <</GEN:DEBUG>>

// ---- info table (last bar) ----
// position size for a new BUY: risk riskPct of the account between the next open (~close) and the initial stop,
// capped at maxPosPct of the account (research: ~10 positions on volatile names)
estStop  = close - trailMult * atr
riskPerSh = close - estStop
sizeSh   = riskPerSh > 0 ? math.floor(math.min(acctSize * riskPct / 100 / riskPerSh, acctSize * maxPosPct / 100 / close)) : 0

// research E30/E56: v3's edge per trade grows with a stock's typical volatility (1-year mean ATR%)
atr1y = ta.sma(atr / close * 100, 252)

// chart statistics text; "OOS" = every trade was selected by a model fitted only on trades that closed before
// that bar's year (walk-forward). The in-sample row uses the final fit, which has seen these years: optimistic.
f_statTxt(int k, int w, float sw, float sl, float sr) =>
    pfx = sl > 0 ? sw / sl : na
    k == 0 ? "no closed trades" : str.tostring(k) + " trades | win " + str.tostring(100.0 * w / k, "#") + "% | PF " + (na(pfx) ? "∞" : str.tostring(pfx, "#.##")) + " | avg " + str.tostring(100 * sr / k, "#.#") + "%"

var table info = table.new(position.top_right, 2, 14, bgcolor = color.new(color.black, 75), border_width = 1)
if showTable and barstate.islast
    inTrade = state == 2 or state == 3
    statusTxt = state == 1 ? "BUY (fill next open)" : state == 3 ? "SELL (exit next open)" : inTrade ? "LONG" : sellSig ? "SOLD" : "flat"
    statusCol = state == 1 or inTrade ? color.green : sellSig ? color.red : color.gray
    table.cell(info, 0, 0, "Swing v3", text_color = color.white)
    table.cell(info, 1, 0, statusTxt, text_color = color.white, bgcolor = color.new(statusCol, 40))
    table.cell(info, 0, 1, "Breakout quality", text_color = color.white)
    table.cell(info, 1, 1, isCand ? str.tostring(quality * 100, "#") + "% " + (qualityOk ? "(ok)" : "(too low)") : "no breakout today", text_color = not isCand ? color.gray : qualityOk ? color.lime : color.orange)
    table.cell(info, 0, 2, "Stop", text_color = color.white)
    table.cell(info, 1, 2, inTrade ? str.tostring(stop, format.mintick) : "-", text_color = color.white)
    table.cell(info, 0, 3, "Risk to stop", text_color = color.white)
    table.cell(info, 1, 3, inTrade ? str.tostring((close - stop) / close * 100, "#.#") + "%" : "-", text_color = color.white)
    table.cell(info, 0, 4, "Bars in trade", text_color = color.white)
    table.cell(info, 1, 4, inTrade ? str.tostring(bar_index - entryBar + 1) : "-", text_color = color.white)
    table.cell(info, 0, 5, "Next earnings", text_color = color.white)
    table.cell(info, 1, 5, na(daysToEarn) ? "n/a" : str.tostring(math.round(daysToEarn)) + " days", text_color = earnSoon ? color.yellow : color.white)
    table.cell(info, 0, 6, "Trend (SMA" + str.tostring(trendLen) + ")", text_color = color.white)
    table.cell(info, 1, 6, close > trendMa ? "up" : "down", text_color = close > trendMa ? color.lime : color.red)
    table.cell(info, 0, 7, "Size if BUY now", text_color = color.white)
    table.cell(info, 1, 7, str.tostring(sizeSh) + " sh (" + str.tostring(sizeSh * close, "#") + ") stop " + str.tostring(estStop, format.mintick), text_color = color.white)
    table.cell(info, 0, 8, "Chart", text_color = color.white)
    table.cell(info, 1, 8, timeframe.isdaily ? "daily ✓" : "use a DAILY chart!", text_color = timeframe.isdaily ? color.white : color.yellow)
    // v3.1 portfolio rule (research E48): keep idle cash in SPY while SPY > its 200-day SMA, else in cash
    table.cell(info, 0, 10, "Idle cash → SPY", text_color = color.white)
    table.cell(info, 1, 10, spyUp == 1.0 ? "YES (SPY > SMA200)" : "NO, hold cash", text_color = spyUp == 1.0 ? color.lime : color.orange)
    table.cell(info, 0, 11, "Volatility 1y (ATR%)", text_color = color.white)
    table.cell(info, 1, 11, na(atr1y) ? "n/a" : str.tostring(atr1y, "#.#") + "% " + (atr1y >= 2.5 ? "good fit" : atr1y >= 1.5 ? "ok fit" : "weak fit"), text_color = na(atr1y) ? color.gray : atr1y >= 2.5 ? color.lime : atr1y >= 1.5 ? color.white : color.orange)
    table.cell(info, 0, 9, "OOS since " + str.format_time(statsFrom, "yyyy"), text_color = color.white)
    table.cell(info, 1, 9, f_statTxt(nTr, nWin, sumWin, sumLoss, sumRet), text_color = color.white)
    if paramsOff
        table.cell(info, 0, 13, "⚠ Settings", text_color = color.black, bgcolor = color.yellow)
        table.cell(info, 1, 13, TRAIN_TXT + ": quality + stats not valid for these settings", text_color = color.black, bgcolor = color.yellow)
    if showIS
        table.cell(info, 0, 12, "In-sample (final fit)", text_color = color.gray)
        table.cell(info, 1, 12, f_statTxt(nTrIs, nWinIs, sumWinIs, sumLossIs, sumRetIs) + " — optimistic", text_color = color.gray)

// earnings warning on a fresh BUY (research E38: entries in the week before earnings were weaker)
plotshape(buySig and earnSoon, "BUY near earnings", shape.circle, location.belowbar, color.yellow, size = size.tiny)

if buySig
    alert("Swing v3 BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | stop after fill: fill - " + str.tostring(trailMult * atr, format.mintick) + " (~" + str.tostring(close - trailMult * atr, format.mintick) + ")" + " | quality " + str.tostring(quality * 100, "#") + "% | size " + str.tostring(sizeSh) + " sh" + (earnSoon ? " | WARNING: earnings in " + str.tostring(math.round(daysToEarn)) + " days" : ""), alert.freq_once_per_bar_close)
if sellSig
    alert("Swing v3 SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

alertcondition(buySig, "Swing v3 BUY", "Swing v3 BUY on {{ticker}} at {{close}}")
alertcondition(halfSig, "Swing v3 HALF PROFIT", "Swing v3: take half profit on {{ticker}}")
alertcondition(sellSig, "Swing v3 SELL", "Swing v3 SELL on {{ticker}} at {{close}}")
