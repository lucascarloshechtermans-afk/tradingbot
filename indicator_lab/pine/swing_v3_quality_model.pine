//@version=5
// Swing buy/sell indicator v3 — v2 (Donchian 20/20 breakout + strong close + 4xATR trail)
// filtered by a logistic "breakout quality" model (meta-labeling).
// Port of indicator_lab/meta.py::meta_breakout {"n":20,"m":20,"trail":4.0,"ibs_min":0.7,"keep":0.75,"l2":100}.
// Model coefficients = indicator_lab/pine/v3_model.json (trained on 3656 DEV breakouts 2013-2026).
// In the backtests the model was refit every year on past data only; this file holds the latest fit.
// BUY = signal at this close, enter next open. SELL = close below prior m-day low (exit next open)
// or trailing stop touched (exit at stop). Daily chart. Not financial advice.
indicator("Swing v3 – breakout + quality model + ATR trail", overlay = true)

n         = input.int(20, "Breakout lookback (days)", minval = 2)
m         = input.int(20, "Exit lookback (days)", minval = 2)
trailMult = input.float(4.0, "Trail (x ATR14)", minval = 0.5, step = 0.25)
trendLen  = input.int(200, "Trend filter SMA", minval = 10)
ibsMin    = input.float(0.7, "Min close position in day range (0-1)", minval = 0, maxval = 1, step = 0.05)
useModel  = input.bool(true, "Use quality model (v3); off = v2")
minQual   = input.float(39.3009, "Min breakout quality % (default = model threshold; higher = stricter)", minval = 0, maxval = 100, step = 1)
spySym    = input.symbol("AMEX:SPY", "Market reference")
tpMult    = input.float(0.0, "Take half profit at +x ATR (0 = off; research E22 used 4)", minval = 0, step = 0.5)
earnDays  = input.int(7, "Earnings warning window (calendar days, 0 = off)", minval = 0)
earnBlock = input.bool(false, "Block BUY inside the earnings window (live bars only)")
showTable = input.bool(true, "Show info table")
acctSize  = input.float(10000, "Account size (for position size)", minval = 0, group = "Position size")
riskPct   = input.float(1.0, "Risk per trade (% of account)", minval = 0.05, step = 0.25, group = "Position size")
maxPosPct = input.float(10.0, "Max position (% of account; ~10 positions)", minval = 1, maxval = 100, group = "Position size")
statsFrom = input.time(timestamp("2015-01-01"), "Count trades from", group = "Chart statistics")
costPct   = input.float(0.1, "Cost per side % (commission + slippage)", minval = 0, step = 0.05, group = "Chart statistics")

f_z(x, mu, sd) => nz((x - mu) / sd)

atr     = ta.atr(14)
trendMa = ta.sma(close, trendLen)
hiN     = ta.highest(high, n)[1]
loM     = ta.lowest(low, m)[1]
ibs     = high > low ? (close - low) / (high - low) : 0.5

// ---- model features (all known at this bar's close) ----
// SPY's close of the same date is only known at the same time for US listings; on other exchanges
// (e.g. Euronext closes before New York) use the previous SPY close to avoid look-ahead/repainting.
spyToday = request.security(spySym, "D", close)
spyPrev  = request.security(spySym, "D", close[1])
spy      = syminfo.timezone == "America/New_York" ? spyToday : spyPrev
volRatio = volume / ta.sma(volume, 50)
rvol     = math.log(math.max(volRatio, 0.05))
roc21    = close / close[21] - 1
roc63    = close / close[63] - 1
roc126   = close / close[126] - 1
atrPct   = atr / close * 100
rsi14    = ta.rsi(close, 14)
ext50    = (close - ta.sma(close, 50)) / atr
spyRoc63 = spy / spy[63] - 1
rs63     = roc63 - spyRoc63
dist52   = close / ta.highest(high, 252) - 1
bbSd     = ta.stdev(close, 20)
bbw      = 4 * bbSd / ta.sma(close, 20)
bbwPct   = ta.percentrank(bbw, 252) / 100
gapAtr   = (open - close[1]) / atr[1]
spyUp    = spy > ta.sma(spy, 200) ? 1.0 : 0.0
rangeAtr = (high - low) / atr[1]
brkAtr   = (close - ta.highest(high, 20)[1]) / atr
er20     = math.abs(close - close[20]) / math.sum(math.abs(ta.change(close)), 20)

score = -0.243512
     + -0.012028 * f_z(ibs, 0.882207, 0.084672)
     + +0.077133 * f_z(rvol, 0.003919, 0.361995)
     + +0.015587 * f_z(roc21, 0.077099, 0.060410)
     + +0.016426 * f_z(roc63, 0.126093, 0.125672)
     + -0.139563 * f_z(roc126, 0.194343, 0.202689)
     + +0.049966 * f_z(atrPct, 1.623357, 0.713240)
     + +0.026913 * f_z(rsi14, 69.836667, 6.165982)
     + -0.021419 * f_z(ext50, 4.176703, 1.826246)
     + +0.089082 * f_z(rs63, 0.066030, 0.118733)
     + -0.014834 * f_z(dist52, -0.021020, 0.041071)
     + -0.046283 * f_z(bbwPct, 0.542481, 0.289020)
     + -0.015639 * f_z(gapAtr, 0.222430, 0.543220)
     + -0.010637 * f_z(spyUp, 0.958161, 0.200220)
     + -0.169306 * f_z(spyRoc63, 0.060063, 0.050280)
     + -0.010604 * f_z(rangeAtr, 1.051659, 0.484647)
     + +0.053239 * f_z(brkAtr, 0.487312, 0.462300)
     + -0.134906 * f_z(er20, 0.391484, 0.180468)
quality = 1 / (1 + math.exp(-score))

// next earnings report: only meaningful on recent bars (TradingView gives the upcoming date only)
nextEarn   = earnings.future_time
daysToEarn = na(nextEarn) ? na : (nextEarn - time_close) / 86400000.0
earnSoon   = earnDays > 0 and not na(daysToEarn) and daysToEarn >= 0 and daysToEarn <= earnDays
earnOk     = not (earnBlock and earnSoon)
qualityOk = not useModel or quality * 100 >= minQual
isCand    = close > hiN and close > trendMa and ibs >= ibsMin

// state: 0 flat, 1 entry pending (fills next open), 2 long, 3 exit pending
var int   state = 0
var float hh    = na
var float stop  = na
var float tp    = na
var bool  halfOff = false
halfSig = false
buySig  = false
sellSig = false
exited  = false  // the engine never re-enters on the bar it exits

// ---- per-chart trade statistics (same fills as the research engine) ----
var float entryPx = na
var bool  counted = false
var int   nTr = 0
var int   nWin = 0
var float sumWin = 0.0
var float sumLoss = 0.0
var float sumRet = 0.0
f_book(exitPx) =>
    r = exitPx * (1 - costPct / 100) / (entryPx * (1 + costPct / 100)) - 1
    r

if state == 3
    if counted
        r3 = f_book(open)
        nTr += 1
        nWin += r3 > 0 ? 1 : 0
        sumWin += math.max(r3, 0)
        sumLoss += math.max(-r3, 0)
        sumRet += r3
    state := 0
    stop := na
    exited := true
if state == 1
    entryPx := open
    counted := time >= statsFrom
    state := 2
    hh := high
    // protective stop from the fill itself: open - trailMult x ATR(signal bar); never hit in the 2015-26 tests,
    // but it covers a crash on the entry day (research E51)
    initStop = open - trailMult * atr[1]
    stop := math.max(initStop, hh - trailMult * atr)
    if low <= initStop
        if counted
            r1 = f_book(initStop)
            nTr += 1
            nWin += r1 > 0 ? 1 : 0
            sumWin += math.max(r1, 0)
            sumLoss += math.max(-r1, 0)
            sumRet += r1
        sellSig := true
        state := 0
        stop := na
    tp := tpMult > 0 ? open + tpMult * atr[1] : na
    halfOff := false
    if state == 2 and tpMult > 0 and high >= tp
        halfSig := true
        halfOff := true
    if state == 2 and close < loM
        sellSig := true
        state := 3
else if state == 2
    if low <= stop
        if counted
            r2 = f_book(math.min(open, stop))
            nTr += 1
            nWin += r2 > 0 ? 1 : 0
            sumWin += math.max(r2, 0)
            sumLoss += math.max(-r2, 0)
            sumRet += r2
        sellSig := true
        state := 0
        stop := na
    else
        if tpMult > 0 and not halfOff and high >= tp
            halfSig := true
            halfOff := true
        hh := math.max(hh, high)
        stop := math.max(stop, hh - trailMult * atr)
        if close < loM
            sellSig := true
            state := 3
var int entryBar = na
if state == 0 and isCand and qualityOk and earnOk and not sellSig and not exited
    buySig := true
    state := 1
    entryBar := bar_index + 1

plot(trendMa, "Trend SMA", color = color.new(color.gray, 40))
plot(state == 2 or state == 3 ? stop : na, "Trailing stop", color = color.red, style = plot.style_linebr)
// confirmed at the close vs provisional while the daily bar is still forming (can still disappear)
plotshape(buySig and barstate.isconfirmed, "BUY", shape.labelup, location.belowbar, color.green, text = "BUY", textcolor = color.white)
plotshape(buySig and not barstate.isconfirmed, "BUY? (bar not closed)", shape.labelup, location.belowbar, color.new(color.green, 60), text = "BUY?", textcolor = color.white)
plot(tpMult > 0 and (state == 2 or state == 3) and not halfOff ? tp : na, "Half-profit target", color = color.teal, style = plot.style_linebr)
plotshape(halfSig, "½ PROFIT", shape.diamond, location.abovebar, color.teal, size = size.tiny, text = "½")
plotshape(sellSig and barstate.isconfirmed, "SELL", shape.labeldown, location.abovebar, color.red, text = "SELL", textcolor = color.white)
plotshape(sellSig and not barstate.isconfirmed, "SELL? (bar not closed)", shape.labeldown, location.abovebar, color.new(color.red, 60), text = "SELL?", textcolor = color.white)
// breakouts the model rejected, for context
plotshape(useModel and state == 0 and isCand and not qualityOk and not sellSig and not exited,
     "Rejected breakout", shape.xcross, location.belowbar, color.new(color.orange, 30), size = size.tiny)
plot(quality, "Breakout quality (0-1)", display = display.data_window)
// for TradingView's Pine Screener: filter a whole watchlist on "Status" = 1 (new BUY) or -1 (SELL)
statusCode = buySig ? 1 : sellSig ? -1 : (state == 2 or state == 3) ? 2 : 0
plot(statusCode, "Status (1 BUY, -1 SELL, 2 long, 0 flat)", display = display.data_window)
// ---- info table (last bar) ----
// position size for a new BUY: risk riskPct of the account between the next open (~close) and the initial stop,
// capped at maxPosPct of the account (research: ~10 positions on volatile names)
estStop  = close - trailMult * atr
riskPerSh = close - estStop
sizeSh   = riskPerSh > 0 ? math.floor(math.min(acctSize * riskPct / 100 / riskPerSh, acctSize * maxPosPct / 100 / close)) : 0

var table info = table.new(position.top_right, 2, 11, bgcolor = color.new(color.black, 75), border_width = 1)
if showTable and barstate.islast
    inTrade = state == 2 or state == 3
    statusTxt = state == 1 ? "BUY (fill next open)" : state == 3 ? "SELL (exit next open)" : inTrade ? "LONG" : sellSig ? "SOLD" : "flat"
    statusCol = state == 1 or inTrade ? color.green : sellSig ? color.red : color.gray
    table.cell(info, 0, 0, "Swing v3", text_color = color.white)
    table.cell(info, 1, 0, statusTxt, text_color = color.white, bgcolor = color.new(statusCol, 40))
    table.cell(info, 0, 1, "Breakout quality", text_color = color.white)
    table.cell(info, 1, 1, isCand ? str.tostring(quality * 100, "#") + "% " + (qualityOk ? "(ok)" : "(too low)") : "no breakout today", text_color = not isCand ? color.gray : qualityOk ? color.lime : color.orange)
    table.cell(info, 0, 2, "Stop", text_color = color.white)
    table.cell(info, 1, 2, inTrade ? str.tostring(stop, format.mintick) : "-", text_color = color.white)
    table.cell(info, 0, 3, "Risk to stop", text_color = color.white)
    table.cell(info, 1, 3, inTrade ? str.tostring((close - stop) / close * 100, "#.#") + "%" : "-", text_color = color.white)
    table.cell(info, 0, 4, "Bars in trade", text_color = color.white)
    table.cell(info, 1, 4, inTrade ? str.tostring(bar_index - entryBar + 1) : "-", text_color = color.white)
    table.cell(info, 0, 5, "Next earnings", text_color = color.white)
    table.cell(info, 1, 5, na(daysToEarn) ? "n/a" : str.tostring(math.round(daysToEarn)) + " days", text_color = earnSoon ? color.yellow : color.white)
    table.cell(info, 0, 6, "Trend (SMA" + str.tostring(trendLen) + ")", text_color = color.white)
    table.cell(info, 1, 6, close > trendMa ? "up" : "down", text_color = close > trendMa ? color.lime : color.red)
    table.cell(info, 0, 7, "Size if BUY now", text_color = color.white)
    table.cell(info, 1, 7, str.tostring(sizeSh) + " sh (" + str.tostring(sizeSh * close, "#") + ") stop " + str.tostring(estStop, format.mintick), text_color = color.white)
    table.cell(info, 0, 8, "Chart", text_color = color.white)
    table.cell(info, 1, 8, timeframe.isdaily ? "daily ✓" : "use a DAILY chart!", text_color = timeframe.isdaily ? color.white : color.yellow)
    // v3.1 portfolio rule (research E48): keep idle cash in SPY while SPY > its 200-day SMA, else in cash
    table.cell(info, 0, 10, "Idle cash → SPY", text_color = color.white)
    table.cell(info, 1, 10, spyUp == 1.0 ? "YES (SPY > SMA200)" : "NO, hold cash", text_color = spyUp == 1.0 ? color.lime : color.orange)
    pf = sumLoss > 0 ? sumWin / sumLoss : na
    table.cell(info, 0, 9, "This chart since " + str.format_time(statsFrom, "yyyy"), text_color = color.white)
    table.cell(info, 1, 9, nTr == 0 ? "no closed trades" : str.tostring(nTr) + " trades | win " + str.tostring(100.0 * nWin / nTr, "#") + "% | PF " + (na(pf) ? "∞" : str.tostring(pf, "#.##")) + " | avg " + str.tostring(100 * sumRet / nTr, "#.#") + "%", text_color = color.white)

// earnings warning on a fresh BUY (research E38: entries in the week before earnings were weaker)
plotshape(buySig and earnSoon, "BUY near earnings", shape.circle, location.belowbar, color.yellow, size = size.tiny)

if buySig
    alert("Swing v3 BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | stop after fill: fill - " + str.tostring(trailMult * atr, format.mintick) + " (~" + str.tostring(close - trailMult * atr, format.mintick) + ")" + " | quality " + str.tostring(quality * 100, "#") + "% | size " + str.tostring(sizeSh) + " sh" + (earnSoon ? " | WARNING: earnings in " + str.tostring(math.round(daysToEarn)) + " days" : ""), alert.freq_once_per_bar_close)
if sellSig
    alert("Swing v3 SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

alertcondition(buySig, "Swing v3 BUY", "Swing v3 BUY on {{ticker}} at {{close}}")
alertcondition(halfSig, "Swing v3 HALF PROFIT", "Swing v3: take half profit on {{ticker}}")
alertcondition(sellSig, "Swing v3 SELL", "Swing v3 SELL on {{ticker}} at {{close}}")
